  <div id="batchesContainer"></div>

  <button class="add-mb-btn" id="addMbBtn" onclick="addMasterBatch()">＋ Add Master Batch</button>
  <button class="submit-btn" id="submitBtn" onclick="submitForm()">SUBMIT CONTAINER MEASUREMENT</button>
</div>

<div id="modalHolder"></div>
<div id="draftsModalHolder"></div>
<div id="rangeModalHolder"></div>

<script>
document.addEventListener('gesturestart',  e=>e.preventDefault(), {passive:false});
document.addEventListener('gesturechange', e=>e.preventDefault(), {passive:false});
document.addEventListener('gestureend',    e=>e.preventDefault(), {passive:false});
document.addEventListener('touchmove', e=>{if(e.touches.length>1)e.preventDefault()}, {passive:false});

let _lastTouchEnd=0;
document.addEventListener('touchend', e=>{
  const now=Date.now();
  if(now-_lastTouchEnd<=300)e.preventDefault();
  _lastTouchEnd=now;
}, {passive:false});

function resetViewportZoom(){
  const vp=document.querySelector('meta[name="viewport"]');
  if(!vp)return;
  const original=vp.getAttribute('content');
  vp.setAttribute('content',original+', maximum-scale=1.0');
  setTimeout(()=>vp.setAttribute('content',original),300);
}
document.addEventListener('focusin',resetViewportZoom);
document.addEventListener('focusout',resetViewportZoom);

let currentMode="",stuffingType="",uidCounter=0,batches=[],containerSnapshot=null;
const VALID_MONTHS=["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];
const comboOptions={colour:[]},comboFocusIdx={colour:-1};

function nextId(p){uidCounter++;return p+"_"+Date.now().toString(36)+"_"+uidCounter}
document.getElementById("date").value=new Date().toISOString().split("T")[0];

function filterCombo(key){
  const inp=document.getElementById(key+"Input"),dd=document.getElementById(key+"Dropdown");
  if(!inp||!dd)return;
  const q=inp.value.trim().toLowerCase();
  const matches=(comboOptions[key]||[]).filter(c=>!q||c.toLowerCase().includes(q));
  if(!matches.length){dd.classList.remove("open");return}
  const r=inp.getBoundingClientRect();
  dd.style.width=r.width+"px";dd.style.left=r.left+"px";dd.style.top=r.bottom+"px";
  dd.innerHTML="";
  matches.forEach(c=>{
    const hi=q?c.replace(new RegExp("("+q.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")+")","gi"),"<mark>$1</mark>"):c;
    const div=document.createElement("div");
    div.className="combo-option";div.innerHTML=hi;
    div.addEventListener("mousedown",e=>selectCombo(key,c,e));
    dd.appendChild(div);
  });
  comboFocusIdx[key]=-1;
  dd.classList.add("open");
}
function selectCombo(key,val,e){
  if(e)e.preventDefault();
  document.getElementById(key+"Input").value=val;
  document.getElementById(key).value=val;
  document.getElementById(key+"Dropdown").classList.remove("open");
  saveDraft();
}
function comboKeydown(e,key){
  const dd=document.getElementById(key+"Dropdown");
  const items=dd?dd.querySelectorAll(".combo-option"):[];
  if(e.key==="ArrowDown"){e.preventDefault();comboFocusIdx[key]=Math.min(comboFocusIdx[key]+1,items.length-1);items.forEach((el,i)=>el.classList.toggle("focused",i===comboFocusIdx[key]))}
  else if(e.key==="ArrowUp"){e.preventDefault();comboFocusIdx[key]=Math.max(comboFocusIdx[key]-1,0);items.forEach((el,i)=>el.classList.toggle("focused",i===comboFocusIdx[key]))}
  else if(e.key==="Enter"){if(comboFocusIdx[key]>=0&&items[comboFocusIdx[key]])selectCombo(key,items[comboFocusIdx[key]].textContent);e.preventDefault()}
  else if(e.key==="Escape"){if(dd)dd.classList.remove("open")}
}
document.addEventListener("click",e=>{if(!e.target.closest(".combo-wrap"))document.querySelectorAll(".combo-dropdown.open").forEach(d=>d.classList.remove("open"))});

function loadMasterData(){
  google.script.run
    .withSuccessHandler(function(data){
      loadDropdown("buyer",data.buyers);
      loadDropdown("marker",data.markers);
      comboOptions.colour=(data.colours||[]).map(v=>String(v).trim()).filter(Boolean);
      window.thicknessOptions=data.thicknesses||[];
      window.finishOptions=data.finishes||[];
      window.hfrwOptions=data.qualityTypes||[];
      window.lotNoOptions=(data.lotNos||[]).map(v=>String(v).trim()).filter(Boolean);
      loadDropdown("masterThickness",window.thicknessOptions);
      loadDropdown("masterFinish",window.finishOptions);
      loadDropdown("masterQuality",window.hfrwOptions);
      populateLotNoDatalist();
      restoreDraft();
      renderAllBatches();
      updateMbControls();
    })
    .withFailureHandler(err=>alert("Failed to load master data: "+(err&&err.message)))
    .getMasterData();
}
function populateLotNoDatalist(){
  const dl=document.getElementById("lotNoList");
  dl.innerHTML="";
  (window.lotNoOptions||[]).forEach(v=>{const o=document.createElement("option");o.value=v;dl.appendChild(o)});
}
function loadDropdown(id,values){
  const sel=document.getElementById(id);if(!sel)return;
  const first=sel.options[0];sel.innerHTML="";sel.appendChild(first);
  (values||[]).forEach(v=>{if(!v)return;const o=document.createElement("option");o.value=String(v).trim();o.textContent=String(v).trim();sel.appendChild(o)});
}

let containerLookupTimer=null;
function onContainerInput(input){
  input.value=input.value.toUpperCase().replace(/[^A-Z0-9]/g,"").substring(0,11);
  saveDraft();
  document.getElementById("containerStatus").textContent="";
  document.getElementById("containerStatus").className="container-status";
  clearTimeout(containerLookupTimer);
  if(input.value.length>=7)containerLookupTimer=setTimeout(onContainerBlur,500);
  if(input.value.length>=11)setTimeout(()=>focusNextField(input),30);
}
function onVehicleNoInput(input){
  input.value=input.value.toUpperCase().replace(/[^A-Z0-9]/g,"").substring(0,10);
  saveDraft();
  if(input.value.length>=10)setTimeout(()=>focusNextField(input),30);
}
function onContainerBlur(){
  const c=document.getElementById("container").value.trim();
  if(!c||c.length<4)return;
  const st=document.getElementById("containerStatus");
  st.textContent="🔍 Checking…";st.className="container-status";
  google.script.run
    .withSuccessHandler(res=>{
      if(res&&res.found){
        containerSnapshot=res;
        const nBatches=(res.batches||[]).length;
        let nSlabs=0;res.batches.forEach(b=>b.lots.forEach(l=>nSlabs+=l.slabs.length));
        st.textContent="⚠️ Container exists — "+nBatches+" batch(es), "+nSlabs+" slabs already in file. Your new entries will be MERGED.";
        st.className="container-status exists";
      }else{
        containerSnapshot=null;
        st.textContent="✅ New container";
        st.className="container-status new";
      }
    })
    .withFailureHandler(err=>{st.textContent="Lookup error: "+(err&&err.message)})
    .getContainerSnapshot(c);
}

function selectMode(mode){
  currentMode=mode;
  document.querySelectorAll(".mode-btn").forEach(b=>b.classList.toggle("active",b.dataset.mode===mode));
  document.getElementById("statMode").textContent=mode==="gross"?"GROSS":"NET";
  batches.forEach(b=>b.lots.forEach(l=>l.slabs.forEach(s=>{
    if(mode==="net"){s.netL=s.netL||s.grossL||"";s.netH=s.netH||s.grossH||""}
    if(mode==="gross"){s.grossL=s.grossL||s.netL||"";s.grossH=s.grossH||s.netH||""}
  })));
  renderAllBatches();
  saveDraft();
}

function applyMasterThickness(){
  let val=document.getElementById("masterThickness").value;
  if(val&&/^\d+$/.test(val.trim()))val=String(parseInt(val.trim(),10))+"CM";
  document.getElementById("masterThickness").classList.toggle("master-active",!!val);
  batches.forEach(b=>b.lots.forEach(l=>l.slabs.forEach(s=>{if(val)s.thickness=val})));
  renderAllBatches();
}
function applyMasterFinish(){
  const val=document.getElementById("masterFinish").value;
  document.getElementById("masterFinish").classList.toggle("master-active",!!val);
  batches.forEach(b=>b.lots.forEach(l=>l.slabs.forEach(s=>{if(val)s.finish=val})));
  renderAllBatches();
}
function applyMasterQuality(){
  const val=document.getElementById("masterQuality").value;
  document.getElementById("masterQuality").classList.toggle("master-active",!!val);
  batches.forEach(b=>b.lots.forEach(l=>l.slabs.forEach(s=>{if(val)s.hfrw=val})));
  renderAllBatches();
}

function formatMasterBatch(input){
  const raw=(input.value||"").toUpperCase().replace(/[^A-Z0-9]/g,"");
  let letters="",d1="",d2="",i=0;
  while(i<raw.length&&letters.length<3&&/[A-Z]/.test(raw[i])){letters+=raw[i];i++}
  while(i<raw.length&&d1.length<3&&/\d/.test(raw[i])){d1+=raw[i];i++}
  while(i<raw.length&&d2.length<3&&/\d/.test(raw[i])){d2+=raw[i];i++}
  let result=letters;
  if(d1)result+="."+d1;
  if(d2)result+="."+d2;
  input.value=result;
  const isValid=letters.length===3&&VALID_MONTHS.indexOf(letters)!==-1;
  input.classList.toggle("si-error",letters.length===3&&!isValid);
  saveDraft();
}
function formatSlabLotNo(input){
  const raw=(input.value||"").toUpperCase().replace(/[^A-Z0-9]/g,"");
  const letters=raw.substring(0,2).replace(/[^A-Z]/g,"");
  const digits=raw.substring(letters.length).replace(/\D/g,"").substring(0,3);
  let result=letters;
  if(letters.length===2){result+=".";if(digits)result+=digits}
  input.value=result;
  saveDraft();
}
function formatCrateNo(input){
  const raw=(input.value||"").toUpperCase();
  let digit="",letter="";
  for(let i=0;i<raw.length;i++){
    const c=raw[i];
    if(!digit&&/[1-9]/.test(c))digit=c;
    else if(digit&&!letter&&(c==="A"||c==="B"))letter=c;
  }
  input.value=digit+letter;
  saveDraft();
}
function formatThickness(input){
  if(!input)return;
  let v=String(input.value||"").trim().toUpperCase().replace(/CM|MM|INCH|"|'/g,"").replace(/\D/g,"").substring(0,2);
  if(!v){input.value="";return}
  input.value=String(parseInt(v,10))+"CM";
  saveDraft();
}
function onlyDigits(input){
  const max=parseInt(input.getAttribute("maxlength"))||4;
  input.value=input.value.replace(/\D/g,"").substring(0,max);
  updateStats();saveDraft();
  if(input.value.length>=max)setTimeout(()=>focusNextField(input),30);
}
function onThkInput(input){
  const d=(input.value||"").replace(/\D/g,"").substring(0,2);
  input.value=d;
  saveDraft();
  if(d.length>=2)formatThickness(input);
}

function addMasterBatch(){
  const type=document.getElementById("masterBatchType").value;
  if(!type){alert("Please select Master Batch Type (Single or Multiple) first.");return}
  if(type==="single"&&batches.length>=1){alert("Single mode allows only 1 Master Batch. Switch to Multiple to add more.");return}
  const mb={id:nextId("mb"),masterBatch:"",crateNo:"",lots:[]};
  batches.push(mb);
  addLot(mb.id);
  updateMbControls();
  saveDraft();
}
function deleteMasterBatch(mbId){
  if(!confirm("Delete this entire Master Batch group and all its lots/slabs?"))return;
  batches=batches.filter(b=>b.id!==mbId);
  renderAllBatches();updateStats();updateMbControls();saveDraft();
}
function onMbTypeChange(){
  const type=document.getElementById("masterBatchType").value;
  if(type==="single"&&batches.length>1){
    alert("You have "+batches.length+" Master Batches. Delete extras (keep only 1) before switching to Single mode.");
    document.getElementById("masterBatchType").value="multiple";
    return;
  }
  updateMbControls();
  saveDraft();
}
function updateMbControls(){
  const type=document.getElementById("masterBatchType").value;
  const btn=document.getElementById("addMbBtn");
  if(!btn)return;
  if(!type){
    btn.style.display="";
    btn.textContent="Select Master Batch Type first";
    btn.disabled=true;
    btn.style.opacity="0.5";
    return;
  }
  btn.disabled=false;
  btn.style.opacity="1";
  btn.textContent="＋ Add Master Batch";
  if(type==="single"){
    btn.style.display=batches.length>=1?"none":"";
  }else{
    btn.style.display="";
  }
}
function addLot(mbId){
  const mb=batches.find(b=>b.id===mbId);if(!mb)return;
  const lot={id:nextId("lot"),lotNo:"",factory:"",purchasedSlabs:0,slabs:[]};
  mb.lots.push(lot);
  addSlab(mbId,lot.id);
  saveDraft();
}
function deleteLot(mbId,lotId){
  if(!confirm("Delete this Lot and all its slabs?"))return;
  const mb=batches.find(b=>b.id===mbId);if(!mb)return;
  mb.lots=mb.lots.filter(l=>l.id!==lotId);
  renderAllBatches();updateStats();saveDraft();
}
function addSlab(mbId,lotId){
  if(!currentMode){alert("Select Measurement Mode first (Gross or Net).");return}
  const mb=batches.find(b=>b.id===mbId);if(!mb)return;
  const lot=mb.lots.find(l=>l.id===lotId);if(!lot)return;
  const mThk=document.getElementById("masterThickness").value;
  const mFin=document.getElementById("masterFinish").value;
  const mQual=document.getElementById("masterQuality").value;
  const defaultCrate=(stuffingType==="crate"&&mb.crateNo)?mb.crateNo:"";
  const s={
    id:nextId("s"),
    slabNo:"",crateNo:defaultCrate,
    thickness:mThk||"",finish:mFin||"",
    netL:"",netH:"",grossL:"",grossH:"",
    hfrw:mQual||""
  };
  lot.slabs.push(s);
  renderAllBatches();
  setTimeout(()=>{
    const el=document.getElementById("slabNo_"+s.id);
    if(el){el.focus();el.scrollIntoView({behavior:"smooth",block:"center"})}
  },100);
  saveDraft();
}
function deleteSlab(mbId,lotId,slabId){
  const mb=batches.find(b=>b.id===mbId);if(!mb)return;
  const lot=mb.lots.find(l=>l.id===lotId);if(!lot)return;
  lot.slabs=lot.slabs.filter(s=>s.id!==slabId);
  renderAllBatches();updateStats();saveDraft();
}

function bindMbInput(mbId,value){
  const mb=batches.find(b=>b.id===mbId);if(!mb)return;
  mb.masterBatch=value;
  saveDraft();
}
function bindMbCrateNo(mbId,value){
  const mb=batches.find(b=>b.id===mbId);if(!mb)return;
  mb.crateNo=value;
  saveDraft();
}
function bindLotInput(mbId,lotId,value){
  const mb=batches.find(b=>b.id===mbId);if(!mb)return;
  const lot=mb.lots.find(l=>l.id===lotId);if(!lot)return;
  lot.lotNo=value;
  saveDraft();
}
function onLotBlur(mbId,lotId){
  const mb=batches.find(b=>b.id===mbId);if(!mb)return;
  const lot=mb.lots.find(l=>l.id===lotId);if(!lot)return;
  const el=document.getElementById("lotInput_"+lotId);
  if(!el)return;
  const m=el.value.trim().match(/^([A-Z]{2})\.(\d{1,3})$/);
  if(!m)return;
  lot.lotNo=m[1]+"."+m[2].padStart(3,"0");
  el.value=lot.lotNo;
  const info=document.getElementById("lotInfo_"+lotId);
  if(info){info.textContent="🔍 Looking up factory & purchased qty…";info.className="lot-info"}
  google.script.run
    .withSuccessHandler(res=>{
      if(res&&res.found){
        lot.factory=res.factory;
        lot.purchasedSlabs=res.purchasedSlabs||0;
      }else{
        lot.factory="";lot.purchasedSlabs=0;
      }
      updateLotInfoLine(lot);
      saveDraft();
    })
    .withFailureHandler(()=>{if(info)info.textContent="⚠️ Lookup failed"})
    .getLotDetails(lot.lotNo);
}
function updateLotInfoLine(lot){
  const info=document.getElementById("lotInfo_"+lot.id);
  if(!info)return;
  const cur=lot.slabs.length;
  if(!lot.lotNo){info.textContent="Enter Lot No…";info.className="lot-info";return}
  if(!lot.factory){info.textContent="⚠️ Lot not in Master Bucket · Adding: "+cur;info.className="lot-info error";return}
  const bal=(lot.purchasedSlabs||0)-cur;
  const balClass=bal<0?"error":"";
  info.textContent=(bal<0?"⚠️":"")+"Purchased: "+lot.purchasedSlabs+" · Entered: "+cur+(bal!==0?" · Bal: "+bal:"");
  info.className="lot-info "+balClass;
}
function getSlabNoHash(slabNo){return slabNo?slabNo.replace(/\D/g,""):""}
function renderAllBatches(){
  const c=document.getElementById("batchesContainer");
  if(!c)return;
  c.innerHTML="";
  batches.forEach((mb,bi)=>{
    const mbHtml=`
    <div class="mb-group">
      <div class="mb-header">
        <span class="mb-icon">📦</span>
        <span class="mb-label">Master Batch ${bi+1}</span>
        <input type="text" class="mb-input" id="mbInput_${mb.id}" value="${mb.masterBatch}" 
          placeholder="e.g. JAN.001.200" oninput="bindMbInput('${mb.id}',this.value)" 
          onblur="formatMasterBatch(this)">
        ${stuffingType==="crate"?`<input type="text" class="mb-input mb-crate" id="mbCrate_${mb.id}" value="${mb.crateNo}" 
          placeholder="Crate" oninput="bindMbCrateNo('${mb.id}',this.value)" onblur="formatCrateNo(this)">`:``}
        <button class="mb-delete" onclick="deleteMasterBatch('${mb.id}')" title="Delete Master Batch">✕</button>
      </div>
      <div class="mb-body">
        ${mb.lots.map((lot,li)=>{
          const slabNoDups=new Set();
          const dupSlabs=new Set();
          lot.slabs.forEach(s=>{
            const h=getSlabNoHash(s.slabNo);
            if(h&&slabNoDups.has(h))dupSlabs.add(s.id);
            else if(h)slabNoDups.add(h);
          });
          return `
          <div class="lot-group">
            <div class="lot-header">
              <span class="lot-icon">📋</span>
              <span class="lot-label">Lot ${li+1}</span>
              <input type="text" class="lot-input" id="lotInput_${lot.id}" value="${lot.lotNo}" 
                placeholder="e.g. AB.123" oninput="bindLotInput('${mb.id}','${lot.id}',this.value)" 
                onblur="onLotBlur('${mb.id}','${lot.id}')" onkeydown="if(event.key==='Enter')onLotBlur('${mb.id}','${lot.id}')">
              <div class="lot-info" id="lotInfo_${lot.id}">Enter Lot No…</div>
              <button class="lot-delete" onclick="deleteLot('${mb.id}','${lot.id}')" title="Delete Lot">✕</button>
            </div>
            <div class="lot-body">
              ${lot.slabs.map((s,si)=>`
              <div class="slab-card ${dupSlabs.has(s.id)?"has-dup":""}">
                <div class="slab-row">
                  <div class="sc-sno"><div class="sc-sno-val">${si+1}</div></div>
                  <div class="sc-slabno">
                    <label class="sc-label">Slab No</label>
                    <input type="text" class="si" id="slabNo_${s.id}" value="${s.slabNo}" 
                      placeholder="No" maxlength="4" oninput="onlyDigits(this)" 
                      onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').slabNo=this.value;saveDraft()">
                    <div class="dup-msg">⚠️ Duplicate</div>
                  </div>
                  ${currentMode==="net"?`
                  <div class="sc-msmtL">
                    <label class="sc-label sc-badge net">Net L</label>
                    <input type="text" class="si" value="${s.netL}" placeholder="0" maxlength="4" oninput="onlyDigits(this)" onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').netL=this.value;updateStats();saveDraft()">
                  </div>
                  <div class="sc-msmtH">
                    <label class="sc-label sc-badge net">Net H</label>
                    <input type="text" class="si" value="${s.netH}" placeholder="0" maxlength="4" oninput="onlyDigits(this)" onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').netH=this.value;updateStats();saveDraft()">
                  </div>
                  `:`
                  <div class="sc-msmtL">
                    <label class="sc-label sc-badge gross">Gross L</label>
                    <input type="text" class="si" value="${s.grossL}" placeholder="0" maxlength="4" oninput="onlyDigits(this)" onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').grossL=this.value;updateStats();saveDraft()">
                  </div>
                  <div class="sc-msmtH">
                    <label class="sc-label sc-badge gross">Gross H</label>
                    <input type="text" class="si" value="${s.grossH}" placeholder="0" maxlength="4" oninput="onlyDigits(this)" onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').grossH=this.value;updateStats();saveDraft()">
                  </div>
                  `}
                  <div class="sc-thk">
                    <label class="sc-label">Thk</label>
                    <input type="text" class="si-select" value="${s.thickness}" placeholder="—" oninput="onThkInput(this)" onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').thickness=this.value;saveDraft()">
                  </div>
                  ${stuffingType==="crate"?`
                  <div class="sc-crate">
                    <label class="sc-label">Crate</label>
                    <input type="text" class="si-select" value="${s.crateNo}" placeholder="—" oninput="this.value=this.value.toUpperCase()" onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').crateNo=this.value;saveDraft()" onblur="formatCrateNo(this)">
                  </div>
                  `:""}
                  <div class="sc-hfrw">
                    <label class="sc-label">Quality</label>
                    <select class="si-select" onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').hfrw=this.value;saveDraft()">
                      <option value="">—</option>
                      ${(window.hfrwOptions||[]).map(opt=>`<option value="${opt}" ${s.hfrw===opt?"selected":""}>${opt}</option>`).join("")}
                    </select>
                  </div>
                  <div class="sc-finish">
                    <label class="sc-label">Finish</label>
                    <select class="si-select" onchange="batches.find(b=>b.id==='${mb.id}').lots.find(l=>l.id==='${lot.id}').slabs.find(sl=>sl.id==='${s.id}').finish=this.value;saveDraft()">
                      <option value="">—</option>
                      ${(window.finishOptions||[]).map(opt=>`<option value="${opt}" ${s.finish===opt?"selected":""}>${opt}</option>`).join("")}
                    </select>
                  </div>
                  <div class="sc-remove">
                    <button class="remove-slab-btn" onclick="deleteSlab('${mb.id}','${lot.id}','${s.id}')" title="Delete slab">✕</button>
                  </div>
                </div>
              </div>
              `).join("")}
              <button class="add-slab-btn" onclick="addSlab('${mb.id}','${lot.id}')">+ Add Slab</button>
            </div>
            <button class="add-lot-btn" onclick="addLot('${mb.id}')">+ Add Lot</button>
          </div>
          `;
        }).join("")}
      </div>
    </div>
    `;
    c.innerHTML+=mbHtml;
  });
  setTimeout(updateLotInfo,100);
}
function updateLotInfo(){
  batches.forEach(b=>b.lots.forEach(l=>updateLotInfoLine(l)));
}
function updateStats(){
  const batN=batches.length;
  let lotN=0,slabN=0,sqmt=0,sqft=0;
  batches.forEach(b=>b.lots.forEach(l=>{
    lotN++;
    l.slabs.forEach(s=>{
      slabN++;
      const u=document.getElementById("unit").value;
      let l_val=parseFloat(currentMode==="net"?s.netL:s.grossL)||0;
      let h_val=parseFloat(currentMode==="net"?s.netH:s.grossH)||0;
      if(l_val&&h_val){
        let area=l_val*h_val;
        if(u==="INCH")area=area/1550;
        sqmt+=area;
        sqft+=area*10.764;
      }
    });
  }));
  document.getElementById("statBatches").textContent=batN;
  document.getElementById("statLots").textContent=lotN;
  document.getElementById("statSlabs").textContent=slabN;
  document.getElementById("statSqmt").textContent=sqmt.toFixed(3);
  document.getElementById("statSqft").textContent=sqft.toFixed(2);
}
function focusNextField(input){
  const allInputs=[...document.querySelectorAll("input,select")].filter(el=>el.offsetParent!==null);
  const idx=allInputs.indexOf(input);
  if(idx>=0&&idx<allInputs.length-1)allInputs[idx+1].focus();
}
function saveDraft(){
  const draft={
    container:document.getElementById("container").value,
    vehicleNumber:document.getElementById("vehicleNumber").value,
    date:document.getElementById("date").value,
    unit:document.getElementById("unit").value,
    buyer:document.getElementById("buyer").value,
    marker:document.getElementById("marker").value,
    colour:document.getElementById("colour").value,
    masterBatchType:document.getElementById("masterBatchType").value,
    currentMode,stuffingType,batches
  };
  localStorage.setItem("cutter_draft",JSON.stringify(draft));
}
function restoreDraft(){
  const saved=localStorage.getItem("cutter_draft");
  if(!saved)return;
  try{
    const draft=JSON.parse(saved);
    document.getElementById("container").value=draft.container||"";
    document.getElementById("vehicleNumber").value=draft.vehicleNumber||"";
    document.getElementById("date").value=draft.date||new Date().toISOString().split("T")[0];
    document.getElementById("unit").value=draft.unit||"";
    document.getElementById("buyer").value=draft.buyer||"";
    document.getElementById("marker").value=draft.marker||"";
    document.getElementById("colour").value=draft.colour||"";
    document.getElementById("masterBatchType").value=draft.masterBatchType||"";
    currentMode=draft.currentMode||"";
    stuffingType=draft.stuffingType||"";
    batches=draft.batches||[];
    if(currentMode)selectMode(currentMode);
  }catch(e){}
}
function submitForm(){
  alert("Submit functionality requires backend configuration. Current data saved to draft.");
  saveDraft();
}
function openDraftsModal(){}
function openRangeSummaryModal(){}
function changeStuffingType(){}
function selectStuffingType(type){
  stuffingType=type;
  document.getElementById("stuffingOverlay").style.display="none";
  document.getElementById("userBadge").style.display="";
  document.getElementById("stuffingBadgeBtn").style.display="";
  renderAllBatches();
  saveDraft();
}
function doLogin(){}
function switchUser(){}
function lockApp(){}

document.addEventListener("DOMContentLoaded",()=>{
  selectStuffingType("crate");
  loadMasterData();
});
</script>
