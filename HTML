const DRAFTS_KEY = "msmt_v4_drafts";
const DRAFT_MAX_AGE_MS = 30 * 24 * 60 * 60 * 1000;
window.CURRENT_DRAFT_ID = null;

function loadAllDrafts() { try { return JSON.parse(localStorage.getItem(DRAFTS_KEY) || "{}"); } catch(e) { return {}; } }
function saveAllDrafts(o) { try { localStorage.setItem(DRAFTS_KEY, JSON.stringify(o)); } catch(e) {} }
function cleanupOldDrafts() {
  const all = loadAllDrafts(); const cutoff = Date.now() - DRAFT_MAX_AGE_MS; let changed = false;
  Object.keys(all).forEach(id => { if (!all[id] || !all[id].savedAt || all[id].savedAt < cutoff) { delete all[id]; changed = true; } });
  if (changed) saveAllDrafts(all);
}
function saveDraft() {
  try {
    const container = document.getElementById("container").value;
    const hasAny = container || batches.length > 0;
    if (!hasAny) return;
    if (!window.CURRENT_DRAFT_ID) window.CURRENT_DRAFT_ID = "d_" + Date.now() + "_" + Math.random().toString(36).slice(2,7);
    const all = loadAllDrafts();
    all[window.CURRENT_DRAFT_ID] = {
      id: window.CURRENT_DRAFT_ID, savedAt: Date.now(),
      container,
      vehicleNumber: document.getElementById("vehicleNumber").value,
      buyer: document.getElementById("buyer").value,
      marker: document.getElementById("marker").value,
      colour: document.getElementById("colour").value,
      colourInput: document.getElementById("colourInput").value,
      unit: document.getElementById("unit").value,
      masterBatchType: document.getElementById("masterBatchType").value,
      measurementMode: currentMode,
      masterThickness: document.getElementById("masterThickness").value,
      masterFinish: document.getElementById("masterFinish").value,
      masterQuality: document.getElementById("masterQuality").value,
      stuffingType: stuffingType,
      batches: JSON.parse(JSON.stringify(batches))
    };
    saveAllDrafts(all);
    updateDraftsBadge();
  } catch(e) {}
}
setInterval(saveDraft, 10000);

function removeCurrentDraft() {
  if (!window.CURRENT_DRAFT_ID) return;
  const all = loadAllDrafts(); delete all[window.CURRENT_DRAFT_ID];
  saveAllDrafts(all); window.CURRENT_DRAFT_ID = null; updateDraftsBadge();
}
function updateDraftsBadge() {
  const badge = document.getElementById("draftsCount");
  const all = loadAllDrafts(); const c = Object.keys(all).length;
  badge.textContent = c; badge.classList.toggle("zero", c === 0);
}
function restoreDraft() {
  cleanupOldDrafts(); updateDraftsBadge();
