/* ═══════════════════════════════════════════════════════════
   STATS
   ═══════════════════════════════════════════════════════════ */
function calcSqmt(l, h, unit) {
  if (!l || !h) return 0;
  if (unit === "CM")   return (l * h) / 10000;
  if (unit === "INCH") return ((l * h) / 144) / 10.764;
  return 0;
}
function updateStats() {
  const unit = document.getElementById("unit").value;
  let nBatches = batches.length, nLots = 0, nSlabs = 0, sqmt = 0;
  batches.forEach(b => b.lots.forEach(l => {
    nLots++;
    l.slabs.forEach(s => {
      nSlabs++;
      const L = currentMode === "net" ? Number(s.netL) : Number(s.grossL);
      const H = currentMode === "net" ? Number(s.netH) : Number(s.grossH);
      sqmt += calcSqmt(L || 0, H || 0, unit);
    });
  }));
  document.getElementById("statBatches").textContent = nBatches;
  document.getElementById("statLots").textContent    = nLots;
  document.getElementById("statSlabs").textContent   = nSlabs;
  document.getElementById("statSqmt").textContent    = sqmt.toFixed(3);
  document.getElementById("statSqft").textContent    = (sqmt * 10.7639).toFixed(2);
  // Also refresh info lines
  batches.forEach(b => b.lots.forEach(l => updateLotInfoLine(l)));
}

/* ═══════════════════════════════════════════════════════════
   RANGE SUMMARY — length/height bracket counts + Sqft, viewable
   any time before submitting via the "📏 Range Summary" button.
   Ranges are checked against the raw entered L / H values.
   ═══════════════════════════════════════════════════════════ */
const LENGTH_RANGES = [
  { label: "91 – 121",  min: 91,  max: 121 },
  { label: "122 – 181", min: 122, max: 181 },
  { label: "182 – 239", min: 182, max: 239 },
  { label: "240+",      min: 240, max: Infinity },
  { label: "150 – 200", min: 150, max: 200 }
];
const HEIGHT_RANGES = [
  { label: "63 – 68", min: 63, max: 68 },
  { label: "65 – 85", min: 65, max: 85 },
  { label: "90+",     min: 90, max: Infinity }
];

function collectAllSlabsForRangeSummary() {
  const unit = document.getElementById("unit").value;
  const list = [];
  batches.forEach(b => b.lots.forEach(l => l.slabs.forEach(s => {
    const L = Number(currentMode === "net" ? s.netL : s.grossL) || 0;
    const H = Number(currentMode === "net" ? s.netH : s.grossH) || 0;
    if (!L && !H) return;
    list.push({ L, H, sqft: calcSqmt(L, H, unit) * 10.7639 });
  })));
  return list;
}

function buildRangeRows(slabList, ranges, dimensionKey) {
  return ranges.map(function(r) {
    let count = 0, sqft = 0;
    slabList.forEach(function(s) {
      const v = s[dimensionKey];
      if (v >= r.min && v <= r.max) { count++; sqft += s.sqft; }
    });
    return `<tr><td class="range-label">${r.label}</td><td>${count}</td><td>${sqft.toFixed(2)}</td></tr>`;
  }).join("");
}

function openRangeSummaryModal() {
  const slabList = collectAllSlabsForRangeSummary();
  const lengthRows = buildRangeRows(slabList, LENGTH_RANGES, "L");
  const heightRows = buildRangeRows(slabList, HEIGHT_RANGES, "H");
  const unit = document.getElementById("unit").value || "—";

  document.getElementById("rangeModalHolder").innerHTML = `
    <div class="wt-modal-overlay" id="rangeModal" onclick="if(event.target===this)closeRangeSummaryModal()">
      <div class="wt-modal">
        <div class="wt-modal-head" style="display:flex;justify-content:space-between;align-items:center">
          <div><h5>📏 Range Summary</h5><p>Unit: ${unit} · ${slabList.length} slab(s) entered so far</p></div>
          <button style="background:none;border:none;color:#aaa;font-size:22px;cursor:pointer" onclick="closeRangeSummaryModal()">✕</button>
        </div>
        <div class="wt-modal-body">
          <div class="range-section-title">Length Range</div>
          <table class="range-table">
            <thead><tr><th>Range</th><th>Slabs</th><th>Sq.Ft</th></tr></thead>
            <tbody>${lengthRows}</tbody>
          </table>
          <div class="range-note">Ranges can overlap by design (e.g. 150–200 is a separate bracket) — a slab may be counted in more than one row.</div>

          <div class="range-section-title">Height Range</div>
          <table class="range-table">
            <thead><tr><th>Range</th><th>Slabs</th><th>Sq.Ft</th></tr></thead>
            <tbody>${heightRows}</tbody>
          </table>
          <div class="range-note">Same overlap rule applies here (63–68 and 65–85 intentionally overlap).</div>
        </div>
        <div class="wt-modal-foot" style="grid-template-columns:1fr">
          <button class="wt-confirm-btn" onclick="closeRangeSummaryModal()">Close</button>
        </div>
      </div>
    </div>`;
}
