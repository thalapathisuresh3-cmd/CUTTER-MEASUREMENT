<script>
/* ═══════════════════════════════════════════════════════════
   HARD ZOOM LOCK
   The viewport meta tag (maximum-scale=1, user-scalable=no) is
   ignored by some in-app browsers (e.g. the WhatsApp/Instagram
   built-in browser card), which still allow pinch-zoom and
   double-tap-zoom gestures. This blocks those gestures directly
   at the JS/event level so the app always fills the screen like
   a native app, in every browser context — not just Safari.
   ═══════════════════════════════════════════════════════════ */
document.addEventListener('gesturestart',  function(e){ e.preventDefault(); }, { passive:false });
document.addEventListener('gesturechange', function(e){ e.preventDefault(); }, { passive:false });
document.addEventListener('gestureend',    function(e){ e.preventDefault(); }, { passive:false });

// Block pinch-zoom (2+ finger touchmove)
document.addEventListener('touchmove', function(e){
  if (e.touches.length > 1) e.preventDefault();
}, { passive:false });

// Block double-tap-to-zoom (two taps within 300ms)
let _lastTouchEnd = 0;
document.addEventListener('touchend', function(e){
  const now = Date.now();
  if (now - _lastTouchEnd <= 300) e.preventDefault();
  _lastTouchEnd = now;
}, { passive:false });

// Force the viewport zoom back to 1.0 every time focus enters or leaves any
// field. This is the actual fix for zoom getting "stuck" — the gesture
// blocking above stops the *user* from pinch-zooming, but doesn't stop the
// browser from zooming in on its own when a field is focused. This forces
// the scale back to normal immediately after, whatever caused the zoom.
function resetViewportZoom() {
  const vp = document.querySelector('meta[name="viewport"]');
  if (!vp) return;
  const original = vp.getAttribute('content');
  vp.setAttribute('content', original + ', maximum-scale=1.0');
  setTimeout(function () { vp.setAttribute('content', original); }, 300);
}
document.addEventListener('focusin', resetViewportZoom);
document.addEventListener('focusout', resetViewportZoom);

/* ═══════════════════════════════════════════════════════════
   STATE
   ═══════════════════════════════════════════════════════════ */
let currentMode = "";
let stuffingType = ""; // "crate" or "loose" — chosen via popup right after login
let uidCounter  = 0;
let batches     = [];   // [{ id, masterBatch, lots: [{ id, lotNo, factory, purchasedSlabs, slabs: [{id,slabNo,crateNo,thickness,netL,netH,grossL,grossH,hfrw,finish}] }] }]
let containerSnapshot = null; // existing file snapshot if any
const VALID_MONTHS = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];
const comboOptions  = { colour: [] };
const comboFocusIdx = { colour: -1 };

function nextId(prefix) { uidCounter++; return prefix + "_" + Date.now().toString(36) + "_" + uidCounter; }

document.getElementById("date").value = new Date().toISOString().split("T")[0];

/* ═══════════════════════════════════════════════════════════
   COMBO (Colour searchable dropdown)
   ═══════════════════════════════════════════════════════════ */
function filterCombo(key) {
  const inp = document.getElementById(key + "Input");
  const dd  = document.getElementById(key + "Dropdown");
  if (!inp || !dd) return;
  const q = inp.value.trim().toLowerCase();
  const matches = (comboOptions[key] || []).filter(c => !q || c.toLowerCase().includes(q));
  if (!matches.length) { dd.classList.remove("open"); return; }
  const r = inp.getBoundingClientRect();
  dd.style.width = r.width + "px"; dd.style.left = r.left + "px"; dd.style.top = r.bottom + "px";
  dd.innerHTML = "";
  matches.forEach(function(c) {
    const hi = q ? c.replace(new RegExp("(" + q.replace(/[.*+?^${}()|[\]\\]/g,"\\$&") + ")","gi"),"<mark>$1</mark>") : c;
    const div = document.createElement("div");
    div.className = "combo-option"; div.innerHTML = hi;
    div.addEventListener("mousedown", function(e) { selectCombo(key, c, e); });
    dd.appendChild(div);
  });
  comboFocusIdx[key] = -1;
  dd.classList.add("open");
}
function selectCombo(key, val, e) {
  if (e) e.preventDefault();
  document.getElementById(key + "Input").value = val;
  document.getElementById(key).value = val;
  document.getElementById(key + "Dropdown").classList.remove("open");
  saveDraft();
}
function comboKeydown(e, key) {
  const dd = document.getElementById(key + "Dropdown");
  const items = dd ? dd.querySelectorAll(".combo-option") : [];
  if (e.key === "ArrowDown") { e.preventDefault(); comboFocusIdx[key] = Math.min(comboFocusIdx[key]+1, items.length-1); items.forEach((el,i) => el.classList.toggle("focused", i===comboFocusIdx[key])); }
  else if (e.key === "ArrowUp") { e.preventDefault(); comboFocusIdx[key] = Math.max(comboFocusIdx[key]-1, 0); items.forEach((el,i) => el.classList.toggle("focused", i===comboFocusIdx[key])); }
  else if (e.key === "Enter") { if (comboFocusIdx[key] >= 0 && items[comboFocusIdx[key]]) selectCombo(key, items[comboFocusIdx[key]].textContent); e.preventDefault(); }
  else if (e.key === "Escape") { if (dd) dd.classList.remove("open"); }
}
document.addEventListener("click", e => {
  if (!e.target.closest(".combo-wrap")) document.querySelectorAll(".combo-dropdown.open").forEach(d => d.classList.remove("open"));
});

/* ═══════════════════════════════════════════════════════════
   MASTER DATA
   ═══════════════════════════════════════════════════════════ */
function loadMasterData() {
  google.script.run
    .withSuccessHandler(function(data) {
      loadDropdown("buyer", data.buyers);
      loadDropdown("marker", data.markers);
      comboOptions.colour = (data.colours || []).map(v => String(v).trim()).filter(Boolean);
      window.thicknessOptions = data.thicknesses || [];
      window.finishOptions    = data.finishes || [];
      window.hfrwOptions      = data.qualityTypes || [];
      window.lotNoOptions     = (data.lotNos || []).map(v => String(v).trim()).filter(Boolean);
      loadDropdown("masterThickness", window.thicknessOptions);
      loadDropdown("masterFinish", window.finishOptions);
      loadDropdown("masterQuality", window.hfrwOptions);
      populateLotNoDatalist();
      restoreDraft();
      renderAllBatches();
      updateMbControls();
    })
    .withFailureHandler(function(err) { alert("Failed to load master data: " + (err && err.message)); })
    .getMasterData();
}
function populateLotNoDatalist() {
  const dl = document.getElementById("lotNoList");
  dl.innerHTML = "";
  (window.lotNoOptions || []).forEach(v => { const o = document.createElement("option"); o.value = v; dl.appendChild(o); });
}
function loadDropdown(id, values) {
  const sel = document.getElementById(id); if (!sel) return;
  const first = sel.options[0]; sel.innerHTML = ""; sel.appendChild(first);
  (values || []).forEach(function(v) { if (!v) return; const o = document.createElement("option"); o.value = String(v).trim(); o.textContent = String(v).trim(); sel.appendChild(o); });
}

/* ═══════════════════════════════════════════════════════════
   CONTAINER
   ═══════════════════════════════════════════════════════════ */
let containerLookupTimer = null;
function onContainerInput(input) {
  input.value = input.value.toUpperCase().replace(/[^A-Z0-9]/g, "").substring(0, 11);
  saveDraft();
  document.getElementById("containerStatus").textContent = "";
  document.getElementById("containerStatus").className = "container-status";
  clearTimeout(containerLookupTimer);
  if (input.value.length >= 7) {
    containerLookupTimer = setTimeout(onContainerBlur, 500);
  }
  if (input.value.length >= 11) {
    setTimeout(function(){ focusNextField(input); }, 30);
  }
}
function onVehicleNoInput(input) {
  input.value = input.value.toUpperCase().replace(/[^A-Z0-9]/g, "").substring(0, 10);
  saveDraft();
  if (input.value.length >= 10) {
    setTimeout(function(){ focusNextField(input); }, 30);
  }
}
function onContainerBlur() {
  const c = document.getElementById("container").value.trim();
  if (!c || c.length < 4) return;
  const st = document.getElementById("containerStatus");
  st.textContent = "🔍 Checking…"; st.className = "container-status";
  google.script.run
    .withSuccessHandler(function(res) {
      if (res && res.found) {
        containerSnapshot = res;
        const nBatches = (res.batches || []).length;
        let nSlabs = 0; res.batches.forEach(b => b.lots.forEach(l => nSlabs += l.slabs.length));
        st.textContent = "⚠️ Container exists — " + nBatches + " batch(es), " + nSlabs + " slabs already in file. Your new entries will be MERGED.";
        st.className = "container-status exists";
      } else {
        containerSnapshot = null;
        st.textContent = "✅ New container";
        st.className = "container-status new";
      }
    })
    .withFailureHandler(function(err) { st.textContent = "Lookup error: " + (err && err.message); })
    .getContainerSnapshot(c);
}

/* ═══════════════════════════════════════════════════════════
   MODE
   ═══════════════════════════════════════════════════════════ */
function selectMode(mode) {
  currentMode = mode;
  document.querySelectorAll(".mode-btn").forEach(b => b.classList.toggle("active", b.dataset.mode === mode));
  document.getElementById("statMode").textContent = mode === "gross" ? "GROSS" : "NET";
  // Re-render all existing slabs to swap the L/H inputs
  batches.forEach(b => b.lots.forEach(l => l.slabs.forEach(s => {
    // Migrate value between modes if user swaps
    if (mode === "net")   { s.netL = s.netL || s.grossL || ""; s.netH = s.netH || s.grossH || ""; }
    if (mode === "gross") { s.grossL = s.grossL || s.netL || ""; s.grossH = s.grossH || s.netH || ""; }
  })));
  renderAllBatches();
  saveDraft();
}

function applyMasterThickness() {
  let val = document.getElementById("masterThickness").value;
  if (val && /^\d+$/.test(val.trim())) val = String(parseInt(val.trim(), 10)) + "CM";
  document.getElementById("masterThickness").classList.toggle("master-active", !!val);
  batches.forEach(b => b.lots.forEach(l => l.slabs.forEach(s => { if (val) s.thickness = val; })));
  renderAllBatches();
}
function applyMasterFinish() {
  const val = document.getElementById("masterFinish").value;
  document.getElementById("masterFinish").classList.toggle("master-active", !!val);
  batches.forEach(b => b.lots.forEach(l => l.slabs.forEach(s => { if (val) s.finish = val; })));
  renderAllBatches();
}
function applyMasterQuality() {
  const val = document.getElementById("masterQuality").value;
  document.getElementById("masterQuality").classList.toggle("master-active", !!val);
  batches.forEach(b => b.lots.forEach(l => l.slabs.forEach(s => { if (val) s.hfrw = val; })));
  renderAllBatches();
}

/* ═══════════════════════════════════════════════════════════
   FORMATTERS
   ═══════════════════════════════════════════════════════════ */
function formatMasterBatch(input) {
  const raw = (input.value || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
  let letters = "", d1 = "", d2 = "", i = 0;
  while (i < raw.length && letters.length < 3 && /[A-Z]/.test(raw[i])) { letters += raw[i]; i++; }
  while (i < raw.length && d1.length < 3 && /\d/.test(raw[i])) { d1 += raw[i]; i++; }
  while (i < raw.length && d2.length < 3 && /\d/.test(raw[i])) { d2 += raw[i]; i++; }
  // IMPORTANT: only add a "." before a segment that actually has content.
  // The old version added the dot as soon as the PREVIOUS segment hit its
  // max length, even if the next segment was empty — that created a
  // trailing dot (e.g. "JAN.001.") that got silently re-added by this
  // same function on every keystroke, making it impossible to backspace
  // past it. Gating on the next segment's length fixes that while the
  // final fully-typed format (JAN.001.200) stays exactly the same.
  let result = letters;
  if (d1) result += "." + d1;
  if (d2) result += "." + d2;
  input.value = result;
  // Validate month
  const isValid = letters.length === 3 && VALID_MONTHS.indexOf(letters) !== -1;
  input.classList.toggle("si-error", letters.length === 3 && !isValid);
  saveDraft();
}
function formatSlabLotNo(input) {
  const raw = (input.value || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
  const letters = raw.substring(0, 2).replace(/[^A-Z]/g, "");
  const digits  = raw.substring(letters.length).replace(/\D/g, "").substring(0, 3);
  let result = letters;
  if (letters.length === 2) { result += "."; if (digits) result += digits; }
  input.value = result;
  saveDraft();
}
function formatCrateNo(input) {
  const raw = (input.value || "").toUpperCase();
  let digit = "", letter = "";
  for (let i = 0; i < raw.length; i++) {
    const c = raw[i];
    if (!digit && /[1-9]/.test(c)) digit = c;              // single digit 1-9 only, never 0 or a 2nd digit
    else if (digit && !letter && (c === "A" || c === "B")) letter = c;
  }
  input.value = digit + letter;
  saveDraft();
}
function formatThickness(input) {
  if (!input) return;
  let v = String(input.value || "").trim().toUpperCase().replace(/CM|MM|INCH|"|'/g,"").replace(/\D/g,"").substring(0,2);
  if (!v) { input.value = ""; return; }
  input.value = String(parseInt(v, 10)) + "CM";
  saveDraft();
}
function onlyDigits(input) {
  const max = parseInt(input.getAttribute("maxlength")) || 4;
  input.value = input.value.replace(/\D/g,"").substring(0, max);
  updateStats(); saveDraft();
  // Auto-advance to the next field once this one is "full" (reached its
  // max digit length) — applies to Slab No, L, and H, which all share
  // this handler. Deferred slightly so the digit is visibly typed first.
  if (input.value.length >= max) {
    setTimeout(function(){ focusNextField(input); }, 30);
  }
}
function onThkInput(input) {
  const d = (input.value || "").replace(/\D/g,"").substring(0,2);
  input.value = d;
  saveDraft();
  if (d.length >= 2) { formatThickness(input); }
}

/* ═══════════════════════════════════════════════════════════
   MASTER BATCH / LOT / SLAB — STATE MUTATIONS
   ═══════════════════════════════════════════════════════════ */
function addMasterBatch() {
  const type = document.getElementById("masterBatchType").value;
  if (!type) { alert("Please select Master Batch Type (Single or Multiple) first."); return; }
  if (type === "single" && batches.length >= 1) {
    alert("Single mode allows only 1 Master Batch. Switch to Multiple to add more.");
    return;
  }
  const mb = { id: nextId("mb"), masterBatch: "", crateNo: "", lots: [] };
  batches.push(mb);
  addLot(mb.id);   // start with 1 lot inside
  updateMbControls();
  saveDraft();
}
function deleteMasterBatch(mbId) {
  if (!confirm("Delete this entire Master Batch group and all its lots/slabs?")) return;
  batches = batches.filter(b => b.id !== mbId);
  renderAllBatches(); updateStats(); updateMbControls(); saveDraft();
}
function onMbTypeChange() {
  const type = document.getElementById("masterBatchType").value;
  if (type === "single" && batches.length > 1) {
    alert("You have " + batches.length + " Master Batches. Delete extras (keep only 1) before switching to Single mode.");
    document.getElementById("masterBatchType").value = "multiple";
    return;
  }
  updateMbControls();
  saveDraft();
}
function updateMbControls() {
  const type = document.getElementById("masterBatchType").value;
  const btn = document.getElementById("addMbBtn");
  if (!btn) return;
  if (!type) {
    btn.style.display = "";
    btn.textContent = "Select Master Batch Type first";
    btn.disabled = true;
    btn.style.opacity = "0.5";
    return;
  }
  btn.disabled = false;
  btn.style.opacity = "1";
  btn.textContent = "＋ Add Master Batch";
  if (type === "single") {
    btn.style.display = batches.length >= 1 ? "none" : "";
  } else {
    btn.style.display = "";
  }
}
function addLot(mbId) {
  const mb = batches.find(b => b.id === mbId); if (!mb) return;
  const lot = { id: nextId("lot"), lotNo: "", factory: "", purchasedSlabs: 0, slabs: [] };
  mb.lots.push(lot);
  addSlab(mbId, lot.id);   // start with 1 slab
  saveDraft();
}
function deleteLot(mbId, lotId) {
  if (!confirm("Delete this Lot and all its slabs?")) return;
  const mb = batches.find(b => b.id === mbId); if (!mb) return;
  mb.lots = mb.lots.filter(l => l.id !== lotId);
  renderAllBatches(); updateStats(); saveDraft();
}
function addSlab(mbId, lotId) {
  if (!currentMode) { alert("Select Measurement Mode first (Gross or Net)."); return; }
  const mb = batches.find(b => b.id === mbId); if (!mb) return;
  const lot = mb.lots.find(l => l.id === lotId); if (!lot) return;
  const mThk  = document.getElementById("masterThickness").value;
  const mFin  = document.getElementById("masterFinish").value;
  const mQual = document.getElementById("masterQuality").value;
  const defaultCrate = (stuffingType === "crate" && mb.crateNo) ? mb.crateNo : "";
  const s = {
    id: nextId("s"),
    slabNo: "", crateNo: defaultCrate,
    thickness: mThk || "", finish: mFin || "",
    netL: "", netH: "", grossL: "", grossH: "",
    hfrw: mQual || ""
  };
  lot.slabs.push(s);
  renderAllBatches();
  // Focus new slab
  setTimeout(function() {
    const el = document.getElementById("slabNo_" + s.id);
    if (el) { el.focus(); el.scrollIntoView({behavior:"smooth", block:"center"}); }
  }, 100);
  saveDraft();
}
function deleteSlab(mbId, lotId, slabId) {
  const mb = batches.find(b => b.id === mbId); if (!mb) return;
  const lot = mb.lots.find(l => l.id === lotId); if (!lot) return;
  lot.slabs = lot.slabs.filter(s => s.id !== slabId);
  renderAllBatches(); updateStats(); saveDraft();
}

