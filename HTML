<div id="mainWrap">
  <div class="card">
    <div class="card-title">📋 Job Details (Shipment / Container Level)</div>
    <div class="job-grid">
      <div class="field-group"><label for="container">Container No *</label>
        <input autocorrect="off" autocapitalize="off" spellcheck="false" type="text" class="form-control job-input-short" id="container" placeholder="" maxlength="11"
          oninput="onContainerInput(this)" onblur="onContainerBlur()"
          autocomplete="off" style="text-transform:uppercase;font-weight:800;letter-spacing:1px"></div>

      <div class="field-group"><label for="vehicleNumber">Vehicle No</label>
        <input autocorrect="off" autocapitalize="off" spellcheck="false" type="text" class="form-control job-input-short" id="vehicleNumber" placeholder="" maxlength="10"
          style="text-transform:uppercase" autocomplete="off" oninput="onVehicleNoInput(this)"></div>

      <div class="field-group"><label for="date">Date *</label>
        <input type="date" class="form-control job-input-short" id="date"></div>

      <div class="field-group"><label for="unit">Unit *</label>
        <select class="form-select job-input-short" id="unit" onchange="updateStats();saveDraft()">
          <option value="">Select</option><option value="CM">CM</option><option value="INCH">INCH</option>
        </select></div>

      <div class="field-group"><label for="buyer">Buyer / Sales *</label>
        <select class="form-select job-input-short" id="buyer" onchange="saveDraft()"><option value="">Select</option></select></div>

      <div class="field-group"><label for="marker">Marker *</label>
        <select class="form-select job-input-short" id="marker" onchange="saveDraft()"><option value="">Select</option></select></div>

      <div class="field-group"><label for="colourInput">Colour *</label>
        <div class="combo-wrap job-input-short">
          <input autocorrect="off" autocapitalize="off" spellcheck="false" type="text" class="combo-input" id="colourInput" placeholder="Type to search…" autocomplete="off"
            oninput="filterCombo('colour')" onfocus="filterCombo('colour')" onkeydown="comboKeydown(event,'colour')">
          <div class="combo-dropdown" id="colourDropdown"></div>
          <input type="hidden" id="colour">
        </div></div>

      <div class="field-group"><label for="masterBatchType">Master Batch Type *</label>
        <select class="form-select job-input-short" id="masterBatchType" onchange="onMbTypeChange()">
          <option value="">Select</option>
          <option value="single">Single</option>
          <option value="multiple">Multiple</option>
        </select></div>

      <div class="field-group job-full"><div class="container-status" id="containerStatus"></div></div>
    </div>
  </div>

  <div class="compact-panel">
