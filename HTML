   SUBMIT FLOW
   ═══════════════════════════════════════════════════════════ */
function submitForm() {
  const payload = collectPayload();
  const errors  = validatePayload(payload);
  if (errors.length) {
    alert("❌ Cannot submit — please fix:\n\n• " + errors.slice(0, 20).join("\n• ") + (errors.length > 20 ? "\n… and " + (errors.length - 20) + " more" : ""));
    return;
  }
  if (!confirm("Submit container " + payload.container + " with " + payload.masterBatches.length + " master batch(es)?\n\nExisting data with same MB+Lot+Slab keys will be REPLACED.")) return;

  const btn = document.getElementById("submitBtn");
  btn.disabled = true; btn.textContent = "Remarks…";

  showRemarksModal(function(remarks) {
    btn.textContent = "Saving…";
    payload.finalRemarks = remarks;
    payload.weightByThk  = {}; // Weight entry step removed from the web app;
                               // the PDF's weight columns simply show "-"
                               // since no per-thickness weight is collected here.

    google.script.run
      .withSuccessHandler(function(result) {
        if (result.status !== "success") {
          alert("Save error: " + (result.message || "unknown"));
          resetSubmitBtn(); return;
        }
        btn.textContent = "PDF…";
        setTimeout(function() {
          const finalData = Object.assign({}, payload, {
              container: result.container,
              masterBatches: result.masterBatches,
              weightByThk: result.weightByThk
            });
            const doc = generatePDF(finalData);
            const blob = doc.output("blob");
            const base64 = doc.output("datauristring");
            const url = URL.createObjectURL(blob);
            const fName = result.container + ".pdf";
            const a = document.createElement("a"); a.href = url; a.download = fName;
            document.body.appendChild(a); a.click(); document.body.removeChild(a);

            removeCurrentDraft();
            document.querySelector(".add-mb-btn").style.display = "none";

            btn.outerHTML = ''
              + '<div class="action-grid" id="actionButtons">'
              + '<div id="emailStatus" style="grid-column:1/-1;padding:10px;background:#fff8e1;border:1.5px solid #ffc107;border-radius:8px;font-size:12px;text-align:center;font-weight:600">📧 Sending email…</div>'
              + '<a href="' + url + '" download="' + fName + '" class="action-btn download">⬇ Download PDF</a>'
              + '<button class="action-btn whatsapp" onclick="shareWA(\'' + url + '\',\'' + fName + '\')">📲 WhatsApp</button>'
              + '<button class="action-btn new-entry" onclick="newEntry()">🔄 New Container</button>'
              + '</div>';

            google.script.run
              .withSuccessHandler(function(mailRes) {
                const s = document.getElementById("emailStatus");
                if (!s) return;
                if (mailRes && mailRes.ok) {
                  s.style.background="#d1e7dd"; s.style.borderColor="#198754"; s.style.color="#0f5132";
                  s.innerHTML = "✅ Email sent to " + (mailRes.to||"");
                } else {
                  s.style.background="#fff5f5"; s.style.borderColor="#dc3545"; s.style.color="#dc3545";
                  s.innerHTML = "⚠️ Email not sent: " + ((mailRes&&mailRes.message)||"unknown");
                }
              })
              .withFailureHandler(function(err) {
                const s = document.getElementById("emailStatus");
                if (s) { s.innerHTML = "⚠️ Email error: " + (err&&err.message||"unknown"); s.style.background="#fff5f5"; s.style.color="#dc3545"; }
              })
              .sendMeasurementEmail(finalData, base64);
          }, 100);
        })
        .withFailureHandler(function(err) { alert("Server error: " + err.message); resetSubmitBtn(); })
        .saveFormData(payload);
  });
}

/* ═══════════════════════════════════════════════════════════
   PDF GENERATION — Per Master Batch section
   ═══════════════════════════════════════════════════════════ */
function generatePDF(fd) {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: "portrait", unit: "mm", format: "a4", compress: true });
  const pageW = doc.internal.pageSize.getWidth(), margin = 8, col = pageW - margin * 2;
  const unit = fd.unit, mode = fd.measurementMode;

  // Title band (no subtitle)
  doc.setFillColor(255, 213, 0); doc.rect(margin, 8, col, 10, "F");
  doc.setFont("helvetica","bold"); doc.setFontSize(13); doc.setTextColor(0,0,0);
  doc.text("SATI EXPORTS INDIA PVT LTD", pageW/2, 15, { align: "center" });

  const now = new Date();
  const dateStr = now.toLocaleDateString("en-IN") + " " + now.toLocaleTimeString("en-IN");
  // Info grid
  const infoLeft  = [["Container", fd.container], ["Vehicle", fd.vehicleNumber || "-"], ["Marker", fd.marker]];
  const infoMid   = [["Buyer", fd.buyer], ["Colour", fd.colour], ["Unit", fd.unit]];
  const infoRight = [["Date", dateStr], ["Mode", mode.toUpperCase()], ["Total Batches", fd.masterBatches.length]];
  let y = 22; const colW = col / 3, rowH = 6;
  doc.setFontSize(9);
  [infoLeft, infoMid, infoRight].forEach(function(group, gi) {
    let gy = y; const xBase = margin + gi * colW;
    group.forEach(function(pair) {
      doc.setFont("helvetica","bold"); doc.setFillColor(230,230,230);
      doc.rect(xBase, gy, colW * 0.4, rowH, "F");
      doc.text(pair[0], xBase + 1, gy + 4.2);
      doc.setFont("helvetica","normal");
      doc.text(String(pair[1] || ""), xBase + colW * 0.42, gy + 4.2);
      doc.rect(xBase, gy, colW, rowH); gy += rowH;
    });
  });
  y += 3 * rowH + 3;

  // Single flat slab table (no banners, no factory column, no emojis)
  const head = ["S.No", "Master Batch", "Lot No", "Slab No", "Crate", "Thk", "L", "H", "Sqmt", "Sqft", "Quality", "Finish"];
  const rows = [];
  let sno = 0;
  fd.masterBatches.forEach(function(batch) {
    batch.lots.forEach(function(lot) {
      lot.slabs.forEach(function(s) {
        sno++;
        const L = Number(s.L) || 0, H = Number(s.H) || 0;
        const sqmt = calcSqmt(L, H, unit);
        rows.push([
          sno,
          batch.masterBatch,
          lot.lotNo,
          buildFormattedSlabTag(s.slabNo, lot.lotNo),
          s.crateNo || "",
          s.thickness || "",
          L || "", H || "",
          sqmt.toFixed(3), (sqmt * 10.7639).toFixed(2),
          s.hfrw || "", s.finish || ""
        ]);
      });
    });
  });
  const raw = [6, 20, 12, 20, 8, 10, 10, 10, 14, 14, 12, 14];
  const scale = col / raw.reduce((a,b) => a + b, 0);
  const styles = {}; raw.forEach((w, i) => { styles[i] = { cellWidth: parseFloat((w * scale).toFixed(2)) }; });
  doc.autoTable({
    head: [head], body: rows, startY: y, margin: { left: margin, right: margin }, tableWidth: col,
    styles: { fontSize: 6.5, cellPadding: {top:1,bottom:1,left:1,right:1}, halign: "center", lineWidth: 0.15, lineColor: [80,80,80] },
    headStyles: { fillColor: [0,0,0], textColor: [255,213,0], fontSize: 7, fontStyle: "bold" },
    alternateRowStyles: { fillColor: [248,248,248] }, columnStyles: styles
  });
  y = doc.lastAutoTable.finalY + 4;

  // Remarks
  if (fd.finalRemarks && String(fd.finalRemarks).trim()) {
    if (y > 275) { doc.addPage(); y = 15; }
    doc.setFontSize(8); doc.setFont("helvetica","bold");
    const lines = doc.splitTextToSize(String(fd.finalRemarks).trim(), col - 22);
    const boxH = Math.max(5.5, 3.2 + lines.length * 3);
    doc.setFillColor(255,248,225); doc.rect(margin, y, col, boxH, "F");
    doc.setDrawColor(255,193,7); doc.rect(margin, y, col, boxH);
    doc.setTextColor(123,88,0); doc.text("REMARKS:", margin + 1.5, y + 3.8);
    doc.setFont("helvetica","italic"); doc.setTextColor(0,0,0);
    doc.text(lines, margin + 16, y + 3.8);
    y += boxH + 3;
  }

  // SUMMARY section — per-thk breakdown with per-batch subtotals + grand total
  if (y > 250) { doc.addPage(); y = 15; }
  doc.setFillColor(17,17,17); doc.rect(margin, y, col, 7, "F");
  doc.setFont("helvetica","bold"); doc.setFontSize(10); doc.setTextColor(255,213,0);
  doc.text("SUMMARY", pageW/2, y + 5, { align: "center" });
  doc.setTextColor(0,0,0); y += 8;

  const sumHead = ["Master Batch","Lot","Thk","Slabs","Sqmt","Sqft","Average","Per Slab Wt","Total Wt"];
  const sumRows = [];
  let grandSlabs = 0, grandSqmt = 0, grandWt = 0;
  const weightByThk = fd.weightByThk || {};
  const subtotalRowIdx = [];
  fd.masterBatches.forEach(function(batch) {
    let bSlabs = 0, bSqmt = 0, bWt = 0;
    batch.lots.forEach(function(lot) {
      const thkAgg = {};
      lot.slabs.forEach(function(s) {
        const sq = calcSqmt(Number(s.L) || 0, Number(s.H) || 0, unit);
        const t = s.thickness || "NA";
        if (!thkAgg[t]) thkAgg[t] = { count: 0, sqmt: 0 };
        thkAgg[t].count += 1; thkAgg[t].sqmt += sq;
      });
      Object.keys(thkAgg).forEach(function(t) {
        const g = thkAgg[t];
        const wt = weightByThk[t];
        const hasWt = (wt !== null && wt !== undefined && !isNaN(parseFloat(wt)));
        const tw = hasWt ? (g.count * parseFloat(wt)) : 0;
        sumRows.push([
          batch.masterBatch, lot.lotNo, t, g.count,
          g.sqmt.toFixed(3), (g.sqmt * 10.7639).toFixed(2),
          (g.sqmt / g.count).toFixed(3),
          hasWt ? (parseFloat(wt).toFixed(2) + " KG") : "-",
          hasWt ? (tw.toFixed(2) + " KG") : "-"
        ]);
        bSlabs += g.count; bSqmt += g.sqmt; if (hasWt) bWt += tw;
      });
    });
    subtotalRowIdx.push(sumRows.length);
    sumRows.push([
      batch.masterBatch + " subtotal","","", bSlabs,
      bSqmt.toFixed(3), (bSqmt * 10.7639).toFixed(2), "", "",
      bWt > 0 ? (bWt.toFixed(2) + " KG") : "-"
    ]);
    grandSlabs += bSlabs; grandSqmt += bSqmt; grandWt += bWt;
  });
  const grandRowIdx = sumRows.length;
  sumRows.push([
    "GRAND TOTAL","","", grandSlabs,
    grandSqmt.toFixed(3), (grandSqmt * 10.7639).toFixed(2), "", "",
    grandWt > 0 ? (grandWt.toFixed(2) + " KG") : "-"
  ]);

  const sumRaw = [22, 14, 10, 10, 14, 14, 12, 16, 18];
  const sumScale = col / sumRaw.reduce((a,b) => a + b, 0);
  const sumStyles = {}; sumRaw.forEach((w, i) => { sumStyles[i] = { cellWidth: parseFloat((w * sumScale).toFixed(2)) }; });
  doc.autoTable({
    head: [sumHead], body: sumRows, startY: y,
    margin: { left: margin, right: margin }, tableWidth: col,
    styles: { fontSize: 7, cellPadding: {top:1.2,bottom:1.2,left:1.2,right:1.2}, halign: "center", lineWidth: 0.15, lineColor: [80,80,80] },
    headStyles: { fillColor: [50,50,50], textColor: [255,255,255], fontSize: 7, fontStyle: "bold" },
    columnStyles: sumStyles,
    didParseCell: function(data) {
      if (data.section !== "body") return;
      const ri = data.row.index;
      if (subtotalRowIdx.indexOf(ri) !== -1) {
        data.cell.styles.fontStyle = "bold";
        data.cell.styles.fillColor = [233,236,239];
      }
      if (ri === grandRowIdx) {
        data.cell.styles.fontStyle = "bold";
        data.cell.styles.fillColor = [255,213,0];
        data.cell.styles.textColor = [0,0,0];
        data.cell.styles.fontSize = 8.5;
      }
    }
  });

  return doc;
}

function buildFormattedSlabTag(slabNo, lotNo) {
  const yy = String(new Date().getFullYear()).slice(-2);
  const p = String(lotNo || "XX.000").split(".");
  const code = (p[0] || "XX").substring(0,2).toUpperCase();
  const lot = (p[1] || "000").padStart(3,"0").substring(0,3);
  const slab = String(parseInt(slabNo) || 0).padStart(3,"0");
  return yy + code + lot + slab;
}

