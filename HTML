<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover, shrink-to-fit=no">
<title>Measurement Entry — Sati Exports</title>
<!-- No external CSS framework: custom mobile-first CSS only -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
/* ═══════════════════════════════════════════════════════════════════════
   SATI EXPORTS — MEASUREMENT ENTRY
   Mobile-only stylesheet. No external CSS framework, no desktop layout,
   no breakpoint-dependent columns — every rule below applies identically
   on every phone at every width. The only two @media blocks left are
   both mobile refinements: one for very small phones (<360px), one for
   landscape orientation on phones. There is nothing here for tablets or
   desktop, by design.

   Structure of this file:
     1. Design tokens (CSS variables)
     2. Global reset / base (incl. native-app touch behavior)
     3. Layout: sticky header + stats bar
     4. Cards & panels
     5. Form fields (fixed 46px height / 16px font everywhere — this is
        what actually stops iOS Safari's auto-zoom-on-focus, and it never
        shrinks at any width)
     6. Job Details (flex-wrap, packs fields tightly by actual width)
     7. Measurement mode + master row
     8. Master Batch / Lot / Slab groups
     9. Buttons
    10. Modals / overlays (weight/remarks/auth/stuffing-type)
    11. Misc (empty state, drafts, badges, range summary)
    12. Small-phone refinement (<360px)
    13. Landscape phone refinement
   ═══════════════════════════════════════════════════════════════════════ */

/* ---------- 1. DESIGN TOKENS ---------- */
:root{
  --yellow:#ffd500;
  --black:#111;
  --gray-bg:#f0f2f5;
  --border:#dee2e6;
  --accent:#1a56db;
  --radius:10px;
  --shadow:0 2px 8px rgba(0,0,0,.08);
  --mb-color:#0f5132;
  --lot-color:#7b5800;

  /* Touch / input sizing tokens — FIXED at all screen widths (not
     breakpoint-dependent). 16px font is what actually prevents iOS
     Safari's auto-zoom-on-focus; height stays in the 44-52px comfort
     zone for touch targets everywhere, including inside the compact
     multi-field slab row. */
  --input-h:46px;
  --input-font:16px;      /* >=16px stops iOS Safari from auto-zooming on focus */
  --tap-min:44px;         /* minimum comfortable tap target */
  --gap:10px;
}

/* ---------- 2. GLOBAL RESET / BASE ---------- */
*{box-sizing:border-box}
html,body{
  margin:0;                      /* kill the browser's default ~8px body margin — */
  padding:0;                     /* this was the visible side gutter around the whole app */
  max-width:100%;
  overflow-x:hidden;             /* no horizontal scrolling on any screen */
  touch-action:manipulation;     /* extra layer: tells the browser not to zoom on tap/gesture */
}
html{
  scroll-behavior:smooth;        /* smooth native-feel scrolling to a focused slab, etc. */
}
*{
  -webkit-tap-highlight-color:transparent;  /* removes the gray flash-on-tap box —
                                                the #1 giveaway that this is "a website"
                                                instead of an app */
}
body{
  background:var(--gray-bg);
  font-family:'Segoe UI',system-ui,sans-serif;
  font-size:15px;
  color:var(--black);
  -webkit-text-size-adjust:100%;
}
html{scroll-padding-top:110px}

/* ---------- 3. STICKY HEADER + STATS ---------- */
.sticky-top-bar{position:sticky;top:0;z-index:200;background:var(--black);box-shadow:0 2px 8px rgba(0,0,0,.25)}
.top-bar-header{background:var(--yellow);padding:4px 10px 3px;text-align:center}
.top-bar-header h1{font-size:14px;font-weight:800;margin:0;line-height:1.2}
.top-bar-header p{font-size:9px;margin:1px 0 0;opacity:.7;font-weight:600;text-transform:uppercase;letter-spacing:1px}
.top-bar-stats{display:flex;align-items:center;justify-content:space-around;padding:4px 4px;flex-wrap:wrap}
.stat-item{text-align:center;min-width:0;flex:1}
.stat-val{font-size:11.5px;font-weight:800;color:var(--yellow);line-height:1}
.stat-lbl{font-size:7px;color:#aaa;text-transform:uppercase;letter-spacing:.4px;margin-top:1px}

/* Header icon buttons — kept compact (they're secondary actions, not form
   fields) but nudged up slightly for easier thumb taps on mobile. */
/* Header icon row — one flex group, top-right. Uniform small icon buttons;
   no more risk of individual absolute-positioned icons overlapping. */
.header-icons{position:absolute;top:8px;right:8px;z-index:201;display:flex;gap:6px}
.header-icon-btn{position:relative;width:36px;height:36px;border:1px solid rgba(255,213,0,.4);border-radius:6px;background:rgba(255,213,0,.12);color:var(--yellow);font-size:15px;cursor:pointer;padding:0;display:flex;align-items:center;justify-content:center}
.header-icon-btn .drafts-count{position:absolute;top:-4px;right:-4px;background:#dc3545;color:#fff;font-size:9px;font-weight:800;min-width:16px;height:16px;padding:0 4px;border-radius:8px;display:flex;align-items:center;justify-content:center;border:1.5px solid var(--black)}
.header-icon-btn .drafts-count.zero{display:none}
.user-badge{position:absolute;top:8px;left:8px;z-index:201;background:rgba(255,213,0,.18);color:var(--yellow);font-size:10px;font-weight:700;padding:5px 8px;border-radius:6px;border:1px solid rgba(255,213,0,.35);display:flex;align-items:center;gap:4px;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

#mainWrap{
    width:100%;
    max-width:100%;
    margin:0;
    padding:10px;
}

/* ---------- 4. CARDS & PANELS ---------- */
.card{
    background:#fff;
    border-radius:12px;
    box-shadow:var(--shadow);
    border:1px solid var(--border);
    padding:14px;
    margin-bottom:12px;
    width:100%;
}
.card-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#666;margin-bottom:6px;padding-bottom:5px;border-bottom:2px solid var(--yellow)}
.compact-panel{
    background:#fff;
    border-radius:12px;
    box-shadow:var(--shadow);
    border:1px solid var(--border);
    padding:14px;
    margin-bottom:12px;
    width:100%;
}
.compact-section-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#444;margin-bottom:8px}

/* ---------- 5. FORM FIELDS (mobile-first defaults) ---------- */
.field-group{margin-bottom:10px}
.field-group label{display:block;font-size:12.5px;font-weight:600;color:#333;margin-bottom:4px}

/* All text/select inputs: full width, tall enough to tap, 16px font so
   iOS Safari does not zoom the viewport on focus. */
.form-control,
.form-select,
.combo-input{
    width:100%;
    height:48px;
    padding:10px 12px;
    font-size:16px;
    border-radius:10px;
    border:1px solid #ced4da;
    background:#fff;
    appearance:none;
}
.form-control:focus,.form-select:focus,.combo-input:focus{
  border-color:var(--accent);box-shadow:0 0 0 2px rgba(26,86,219,.12);outline:none;background:#fff;
}
input[readonly],input[readonly]:focus{background:#f0f2f5!important;color:#666;box-shadow:none}

/* Uniform short width: used on every field that doesn't need the full
   grid-column width (Container No, Vehicle No, and now all other Job
   Details / Master fields per request) so they all render at exactly
   the same size instead of each auto-sizing to its own content.
   Height and font-size are untouched — width only. */
.job-input-short{
    width:100% !important;
    max-width:100%;
}

.combo-wrap{position:relative}
.combo-dropdown{display:none;position:fixed;background:#fff;border:1.5px solid var(--border);border-radius:8px;box-shadow:0 6px 20px rgba(0,0,0,.15);z-index:9999;max-height:220px;overflow-y:auto;-webkit-overflow-scrolling:touch}
.combo-dropdown.open{display:block}
.combo-option{padding:12px;font-size:15px;cursor:pointer;color:var(--black)}
.combo-option:hover,.combo-option.focused{background:#f0f4ff;color:var(--accent)}
.combo-option mark{background:transparent;color:var(--accent);font-weight:700;padding:0}

/* ---------- 6. JOB DETAILS ----------
   Was a rigid 2-column CSS Grid (each column always 50% width, whatever
   was inside it). Now that every field is a fixed short width, Grid left
   a dead gap next to each field. Flexbox+wrap packs fields tightly by
   their actual width instead, filling the row edge to edge with no
   wasted column space, and still wraps naturally on any screen size. */
.job-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
    width:100%;
}

.job-grid .field-group{
    width:100%;
    min-width:0;
    margin:0;
}

.job-grid .field-group.job-full{
    grid-column:1/-1;
}
.container-status{font-size:11px;margin-top:4px;font-weight:600;min-height:14px;line-height:1.4}
.container-status.exists{color:#7b5800}
.container-status.new{color:#0f5132}

/* ---------- 7. MEASUREMENT MODE + MASTER ROW ----------
   Fixed layout at all widths (see note in section 6 above). */
.mode-bar{display:flex;flex-direction:row;gap:8px;margin-bottom:8px}
.mode-btn{width:100%;min-height:var(--tap-min);padding:12px 6px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:14px;font-weight:700;text-align:center;cursor:pointer;color:#555;line-height:1.3;transition:all .15s}
.mode-btn.active{border-color:var(--accent);background:var(--accent);color:#fff;box-shadow:0 3px 8px rgba(26,86,219,.28)}

/* 3 equal columns: Master Thickness / Master Finish / Master Quality.
   These are <select> elements (native pickers), so shrinking their
   font/height slightly to fit 3-up is safe — it does not trigger the
   iOS auto-zoom bug (that only affects free-text inputs). */
.master-row{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
    margin-bottom:12px;
}
.master-row .field-group{margin-bottom:0;min-width:0}
.master-row .field-group label{font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.master-row .form-select{height:42px;font-size:12.5px;padding:4px 6px}
.master-active{background:#fff3cd!important;border-color:#ffc107!important}
.master-tip{font-size:10px;color:#aaa;font-style:italic}

/* ---------- 8. MASTER BATCH / LOT / SLAB GROUPS ---------- */
.mb-group{background:#fff;border:2px solid var(--mb-color);border-radius:var(--radius);margin-bottom:12px;overflow:hidden;box-shadow:var(--shadow)}
.mb-header{background:var(--mb-color);color:#fff;padding:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.mb-header .mb-icon{font-size:16px}
.mb-header .mb-label{font-size:10px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;opacity:.9}
.mb-header .mb-input{flex:1;min-width:140px;height:40px;padding:2px 8px;border:none;border-radius:6px;background:#fff;color:var(--black);font-size:16px;font-weight:800;text-align:center;letter-spacing:1px}
.mb-header .mb-input:focus{outline:2px solid var(--yellow)}
.mb-header .mb-input.si-error{background:#fff5f5;color:#dc3545;box-shadow:0 0 0 2px rgba(220,53,69,.3)}
.mb-header .mb-input.mb-crate{flex:0 0 64px;min-width:64px;text-transform:uppercase}
.mb-header .mb-delete{width:40px;height:40px;background:rgba(255,255,255,.2);border:none;border-radius:6px;color:#fff;font-size:16px;cursor:pointer;flex:0 0 40px}
.mb-header .mb-delete:hover{background:rgba(255,255,255,.35)}
.mb-body{padding:10px}

.lot-group{background:#fafafa;border:1.5px solid #ffc107;border-radius:8px;margin-bottom:10px;overflow:hidden}
.lot-header{background:#fff3cd;color:var(--lot-color);padding:8px 10px;display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.lot-header .lot-icon{font-size:14px}
.lot-header .lot-label{font-size:10px;font-weight:800;letter-spacing:.5px;text-transform:uppercase}
.lot-header .lot-input{flex:0 1 120px;height:38px;padding:2px 8px;border:1.5px solid #ffc107;border-radius:6px;background:#fff;color:var(--black);font-size:15px;font-weight:800;text-align:center;letter-spacing:.5px;text-transform:uppercase}
.lot-header .lot-input:focus{outline:2px solid var(--accent);border-color:var(--accent)}
.lot-header .lot-info{flex:1 1 100%;font-size:11px;font-weight:700;padding:3px 0;line-height:1.4}
.lot-header .lot-info.error{color:#dc3545}
.lot-header .lot-info.warn{color:#dc3545;font-weight:800}
.lot-header .lot-info b{font-weight:800}
.lot-header .lot-delete{width:34px;height:34px;background:#fff;border:1.5px solid #dc3545;border-radius:6px;color:#dc3545;font-size:14px;cursor:pointer;flex:0 0 34px}
.lot-body{padding:6px 8px 8px;background:#fff}

/* SLAB ROW — fixed compact single-line, multi-field layout at all widths
   (see note in section 6). Field order: Slab No, L, H, Thk, Crate,
   Quality Type, Finish (Crate only appears in Crate Loading mode). */
.slab-card{background:#fff;border-bottom:1px solid #eee;padding:8px 4px}
.slab-card:last-child{border-bottom:none}
.slab-row{display:flex;flex-direction:row;flex-wrap:wrap;align-items:flex-end;gap:6px;width:100%}
.sc-sno{flex:0 0 34px;min-width:0;position:relative}
.sc-slabno{flex:1.1 1 0;min-width:56px;position:relative}
.sc-crate{flex:0.8 1 0;min-width:50px;position:relative}
.sc-thk{flex:1 1 0;min-width:50px;position:relative}
.sc-msmtL,.sc-msmtH{flex:1.1 1 0;min-width:56px;position:relative}
.sc-hfrw,.sc-finish{flex:2 1 0;min-width:100px;position:relative}
.sc-remove{flex:0 0 44px;min-width:0;position:relative}
.sc-sno-val{height:var(--input-h);display:flex;align-items:center;justify-content:center;background:var(--yellow);color:#000;font-size:15px;font-weight:800;border-radius:8px}
.sc-label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:#555;margin-bottom:4px;white-space:nowrap}
.sc-badge{display:block;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;padding:2px 4px;border-radius:4px;margin-bottom:4px;text-align:center}
.sc-badge.gross{background:#fff3cd;color:#7b5800}
.sc-badge.net{background:#d1e7dd;color:#0f5132}

.si{width:100%;height:var(--input-h);border:1.5px solid var(--border);border-radius:8px;font-size:var(--input-font);font-weight:700;text-align:center;background:#fafafa;padding:4px;color:var(--black);-webkit-appearance:none}
.si:focus{border-color:var(--accent);outline:none;background:#fff;box-shadow:0 0 0 2px rgba(26,86,219,.12)}
.si-select{width:100%;height:var(--input-h);border:1.5px solid var(--border);border-radius:8px;font-size:15px;font-weight:600;background:#fafafa;padding:4px 8px;color:var(--black)}
.si.si-error{border-color:#dc3545!important;background:#fff5f5!important;box-shadow:0 0 0 2px rgba(220,53,69,.15)}
.dup-msg{position:absolute;left:0;right:0;top:100%;margin-top:2px;background:#dc3545;color:#fff;font-size:10px;font-weight:700;padding:3px 6px;border-radius:4px;text-align:center;white-space:nowrap;z-index:10;display:none}
.sc-slabno.has-dup .dup-msg{display:block}
.remove-slab-btn{width:100%;min-height:var(--tap-min);border:1.5px solid #dc3545;border-radius:8px;background:#fff5f5;color:#dc3545;font-size:15px;font-weight:700;cursor:pointer;padding:10px;display:flex;align-items:center;justify-content:center}

/* ---------- 9. BUTTONS (full width, tap-friendly by default) ---------- */
.add-slab-btn{width:100%;min-height:var(--tap-min);border:1.5px dashed var(--accent);border-radius:8px;background:rgba(26,86,219,.04);color:var(--accent);font-size:14px;font-weight:700;cursor:pointer;margin-top:6px}
.add-lot-btn{width:100%;min-height:var(--tap-min);border:1.5px dashed #ffc107;border-radius:8px;background:#fff8e1;color:#7b5800;font-size:14px;font-weight:700;cursor:pointer;margin-top:8px}
.add-mb-btn{width:100%;min-height:52px;border:2px dashed var(--mb-color);border-radius:var(--radius);background:#d1e7dd;color:var(--mb-color);font-size:15px;font-weight:800;cursor:pointer;margin-bottom:10px}
.submit-btn{width:100%;min-height:52px;background:var(--black);color:var(--yellow);border:none;border-radius:var(--radius);font-size:16px;font-weight:800;cursor:pointer;margin-bottom:12px}
.add-slab-btn,
.add-lot-btn,
.add-mb-btn,
.submit-btn{
    width:100%;
    height:52px;
    border-radius:12px;
    font-size:16px;
    font-weight:700;
}

/* Post-submit action buttons: stacked full width on mobile, 2-col on desktop */
.action-grid{display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:20px}
.action-btn{min-height:52px;border:none;border-radius:var(--radius);font-size:15px;font-weight:700;cursor:pointer;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:6px}
.action-btn.download{background:#198754;color:#fff}
.action-btn.whatsapp{background:#25d366;color:#fff}
.action-btn.new-entry{background:var(--yellow);color:var(--black)}

/* ---------- 10. MODALS / OVERLAYS ---------- */
.wt-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:10000;display:flex;align-items:center;justify-content:center;padding:16px}
.wt-modal{background:#fff;border-radius:14px;width:100%;max-width:420px;max-height:90vh;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.25);display:flex;flex-direction:column}
.wt-modal-head{background:var(--black);padding:14px 18px;flex:0 0 auto}
.wt-modal-head h5{color:var(--yellow);font-size:16px;font-weight:800;margin:0}
.wt-modal-head p{color:#aaa;font-size:11px;margin:2px 0 0}
.wt-modal-body{padding:16px 18px;overflow-y:auto;flex:1 1 auto;-webkit-overflow-scrolling:touch}
.wt-row{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1.5px solid var(--border);border-radius:8px;margin-bottom:8px;background:#fafafa;flex-wrap:wrap}
.wt-row-thk{flex:0 0 80px}
.wt-thk-badge{display:inline-block;background:var(--black);color:var(--yellow);font-size:13px;font-weight:800;padding:4px 10px;border-radius:6px}
.wt-row-info{flex:1 1 120px;font-size:11px;color:#666}
.wt-row-info strong{display:block;font-size:13px;color:var(--black);font-weight:700}
.wt-input-wrap{flex:0 0 110px;position:relative}
.wt-input{width:100%;height:44px;border:2px solid var(--border);border-radius:8px;font-size:16px;font-weight:700;text-align:center;background:#fff;color:var(--black);padding:2px 26px 2px 6px}
.wt-input-unit{position:absolute;right:6px;top:50%;transform:translateY(-50%);font-size:10px;font-weight:700;color:#888;pointer-events:none}
.wt-modal-foot{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0 18px 16px;flex:0 0 auto}
.wt-cancel-btn{min-height:48px;border:2px solid var(--border);border-radius:8px;background:#fff;font-size:14px;font-weight:700;cursor:pointer;color:#555}
.wt-confirm-btn{min-height:48px;border:none;border-radius:8px;background:var(--black);color:var(--yellow);font-size:14px;font-weight:800;cursor:pointer}
.wt-skip-note{text-align:center;font-size:10px;color:#aaa;padding:0 18px 12px;font-style:italic}

/* RANGE SUMMARY MODAL TABLES */
.range-section-title{font-size:12px;font-weight:800;text-transform:uppercase;color:#444;margin:12px 0 6px;letter-spacing:.4px}
.range-section-title:first-child{margin-top:0}
.range-table{width:100%;border-collapse:collapse;margin-bottom:8px}
.range-table th,.range-table td{border:1px solid var(--border);padding:7px 6px;font-size:12.5px;text-align:center}
.range-table th{background:#f0f2f5;font-weight:700;color:#444}
.range-table td.range-label{font-weight:700;text-align:left;color:#333}
.range-note{font-size:10.5px;color:#999;font-style:italic;margin-bottom:10px}

/* AUTH */
.auth-overlay{position:fixed;inset:0;z-index:99999;background:linear-gradient(135deg,#1a1a1a 0%,#2a2a2a 100%);display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto;-webkit-overflow-scrolling:touch}
.auth-card{background:#fff;border-radius:16px;padding:28px 22px;width:100%;max-width:360px;max-height:90vh;overflow-y:auto;-webkit-overflow-scrolling:touch;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.auth-brand{text-align:center;margin-bottom:20px}
.auth-brand .auth-logo{background:var(--yellow);color:var(--black);font-size:14px;font-weight:800;padding:8px 14px;border-radius:8px;display:inline-block;margin-bottom:10px}
.auth-brand h2{font-size:18px;font-weight:800;color:var(--black);margin:0}
.auth-brand p{font-size:11px;color:#888;margin:4px 0 0;text-transform:uppercase;font-weight:600}
.auth-field{margin-bottom:14px}
.auth-field label{display:block;font-size:11px;font-weight:700;color:#555;text-transform:uppercase;margin-bottom:6px}
.auth-input{width:100%;height:48px;border:2px solid var(--border);border-radius:8px;font-size:16px;padding:6px 12px;background:#fafafa}
.auth-input:focus{border-color:var(--accent);outline:none;background:#fff}
.auth-input[readonly]{background:#f0f2f5;color:#666}
.auth-remember{display:flex;align-items:center;gap:8px;margin-bottom:16px;font-size:13px;font-weight:600;color:#444;cursor:pointer}
.auth-btn{width:100%;min-height:50px;background:var(--black);color:var(--yellow);border:none;border-radius:8px;font-size:15px;font-weight:800;cursor:pointer}
.auth-error{background:#fff5f5;color:#dc3545;border:1.5px solid #dc3545;border-radius:7px;padding:8px 10px;font-size:12px;font-weight:600;margin-bottom:12px;text-align:center}
.auth-locked-msg{background:#fff8e1;border-left:3px solid #ffc107;padding:8px 12px;border-radius:6px;font-size:12px;color:#7b5800;margin-bottom:14px;font-weight:600;text-align:center}
.auth-switch{text-align:center;margin-top:14px;font-size:12px;color:#666}
.auth-switch a{color:var(--accent);text-decoration:none;font-weight:700;cursor:pointer}

/* STUFFING TYPE POPUP */
