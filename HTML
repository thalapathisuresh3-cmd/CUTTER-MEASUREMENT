          crateNo:   stuffingType === "crate" ? s.crateNo : "",
          thickness: s.thickness,
          L: currentMode === "net" ? Number(s.netL) || 0 : Number(s.grossL) || 0,
          H: currentMode === "net" ? Number(s.netH) || 0 : Number(s.grossH) || 0,
          hfrw:      s.hfrw,
          finish:    s.finish
        }))
      }))
    }))
  };
  return payload;
}

function validatePayload(p) {
  const errors = [];
  if (!p.container) errors.push("Container No is required");
  else if (p.container.length < 4) errors.push("Container No too short");
  if (!p.buyer) errors.push("Buyer required");
  if (!p.marker) errors.push("Marker required");
  if (!p.colour) errors.push("Colour required");
  if (!p.unit) errors.push("Unit required");
  if (!p.masterBatchType) errors.push("Master Batch Type required (Single or Multiple)");
  else if (p.masterBatchType === "single" && p.masterBatches.length > 1) errors.push("Single mode allows only 1 Master Batch");
  if (!p.measurementMode) errors.push("Measurement Mode required (Gross or Net)");
  if (!p.masterBatches.length) errors.push("At least one Master Batch required");
  p.masterBatches.forEach((mb, i) => {
    const idx = i + 1;
    if (!mb.masterBatch) errors.push("MB #" + idx + ": Master Batch code missing");
    else if (!/^([A-Z]{3})\.(\d{3})\.(\d{3})$/.test(mb.masterBatch) || VALID_MONTHS.indexOf(mb.masterBatch.substring(0,3)) === -1)
      errors.push("MB #" + idx + " (" + mb.masterBatch + "): invalid format — must be MMM.###.### with valid month");
    if (!mb.lots.length) errors.push("MB #" + idx + ": no lots");
    mb.lots.forEach((lot, j) => {
      const lidx = "MB #" + idx + " Lot #" + (j + 1);
      if (!lot.lotNo) errors.push(lidx + ": Lot No missing");
      else if (!/^[A-Z]{2}\.\d{3}$/.test(lot.lotNo)) errors.push(lidx + " (" + lot.lotNo + "): invalid — must be XX.### (e.g. AK.001)");
      if (!lot.factory) errors.push(lidx + " (" + lot.lotNo + "): factory not resolved — lot not found in Master Bucket");
      if (!lot.slabs.length) errors.push(lidx + " (" + lot.lotNo + "): no slabs");
      const slabNumsSeen = {};
      lot.slabs.forEach((s, k) => {
        const sidx = lidx + " Slab #" + (k + 1);
        if (!s.slabNo) errors.push(sidx + ": Slab No missing");
        else if (slabNumsSeen[s.slabNo]) errors.push(sidx + " (SlabNo " + s.slabNo + "): duplicate within lot");
        slabNumsSeen[s.slabNo] = true;
        if (!s.thickness) errors.push(sidx + ": Thickness missing");
        if (!s.L) errors.push(sidx + ": Length missing");
        if (!s.H) errors.push(sidx + ": Height missing");
        if (!s.hfrw) errors.push(sidx + ": Quality Type missing");
        if (!s.finish) errors.push(sidx + ": Finish missing");
      });
    });
  });
  return errors;
}

