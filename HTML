    <div class="mode-bar">
      <div class="mode-btn" data-mode="gross" onclick="selectMode('gross')">Gross Only</div>
      <div class="mode-btn" data-mode="net" onclick="selectMode('net')">Net Only</div>
    </div>
    <div class="master-row">
      <div class="field-group"><label>⚡ Master Thickness</label>
        <select class="form-select job-input-short" id="masterThickness" onchange="applyMasterThickness()">
          <option value="">Blank = per slab</option></select></div>
      <div class="field-group"><label>⚡ Master Finish</label>
        <select class="form-select job-input-short" id="masterFinish" onchange="applyMasterFinish()">
          <option value="">Blank = per slab</option></select></div>
      <div class="field-group"><label>⚡ Master Quality</label>
        <select class="form-select job-input-short" id="masterQuality" onchange="applyMasterQuality()">
