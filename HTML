    + '<button style="background:#1a56db;color:#fff;border:none;padding:5px 10px;border-radius:5px;font-size:11px;font-weight:700;cursor:pointer" onclick="openDraftsModal()">View</button>'
    + '<button style="background:none;border:none;color:#666;font-size:16px;cursor:pointer" onclick="this.parentElement.remove()">✕</button>';
  wrap.insertBefore(b, wrap.firstChild);
}
function openDraftsModal() {
  const all = loadAllDrafts();
  const ids = Object.keys(all).sort((a,b) => (all[b].savedAt||0) - (all[a].savedAt||0));
  let body = ids.length === 0 ? '<div style="text-align:center;color:#888;padding:30px 10px;font-style:italic">No saved drafts.</div>' :
    ids.map(id => {
      const d = all[id]; const isCur = id === window.CURRENT_DRAFT_ID;
      let nSlabs = 0, nLots = 0;
      (d.batches || []).forEach(b => { b.lots?.forEach(l => { nLots++; nSlabs += (l.slabs || []).length; }); });
      return `<div style="border:1.5px solid ${isCur?'#1a56db':'#dee2e6'};background:${isCur?'#f0f4ff':'#fafafa'};border-radius:8px;padding:9px 10px;margin-bottom:8px">
        <div style="font-weight:800;font-size:13px">${d.container || '(no container)'} ${isCur?'<span style="background:#1a56db;color:#fff;font-size:8px;font-weight:700;padding:2px 5px;border-radius:3px">CURRENT</span>':''} ${d.stuffingType ? '<span style="background:'+(d.stuffingType==='crate'?'#0f5132':'#7b5800')+';color:#fff;font-size:8px;font-weight:700;padding:2px 5px;border-radius:3px;margin-left:4px">'+(d.stuffingType==='crate'?'🚛 CRATE':'📦 LOOSE')+'</span>' : ''}</div>
        <div style="font-size:10px;color:#888;margin:4px 0">${(d.batches||[]).length} batches · ${nLots} lots · ${nSlabs} slabs · ${new Date(d.savedAt).toLocaleString("en-IN")}</div>
        <div style="display:flex;gap:6px">
          <button style="flex:1;height:32px;background:#198754;color:#fff;border:none;border-radius:5px;font-size:12px;font-weight:700;cursor:pointer" onclick="restoreSpecificDraft('${id}')">🔄 Restore</button>
          <button style="width:36px;height:32px;background:#fff;border:1.5px solid #dc3545;color:#dc3545;border-radius:5px;cursor:pointer" onclick="deleteDraft('${id}')">🗑</button>
        </div></div>`;
    }).join("");
  document.getElementById("draftsModalHolder").innerHTML = `
    <div class="wt-modal-overlay" onclick="if(event.target===this)document.getElementById('draftsModalHolder').innerHTML=''">
      <div class="wt-modal" style="max-height:80vh;display:flex;flex-direction:column">
        <div class="wt-modal-head" style="display:flex;justify-content:space-between;align-items:center">
          <h5>📁 Saved Drafts (${ids.length})</h5>
          <button style="background:none;border:none;color:#aaa;font-size:22px;cursor:pointer" onclick="document.getElementById('draftsModalHolder').innerHTML=''">✕</button>
        </div>
        <div style="padding:10px 12px;overflow-y:auto;flex:1">${body}</div>
      </div></div>`;
}
function deleteDraft(id) {
  if (!confirm("Delete this draft?")) return;
  const all = loadAllDrafts(); delete all[id];
  saveAllDrafts(all);
  if (id === window.CURRENT_DRAFT_ID) window.CURRENT_DRAFT_ID = null;
  openDraftsModal(); updateDraftsBadge();
}
function restoreSpecificDraft(id) {
  const all = loadAllDrafts(); const d = all[id]; if (!d) return;
  // Guard: a draft saved under Crate Loading can't be restored while in
  // Loose Stuffing mode, and vice versa — the crate fields it depends on
  // won't match the current session's setup.
  if (d.stuffingType && stuffingType && d.stuffingType !== stuffingType) {
    const dLabel = d.stuffingType === "crate" ? "Crate Loading" : "Loose Stuffing";
    const curLabel = stuffingType === "crate" ? "Crate Loading" : "Loose Stuffing";
    alert("This draft was saved under \"" + dLabel + "\" mode, but you're currently in \"" + curLabel + "\" mode.\n\nSwitch stuffing type first (tap the 🚛/📦 icon in the header) before restoring this draft.");
    return;
  }
  document.getElementById("draftsModalHolder").innerHTML = "";
  window.CURRENT_DRAFT_ID = id;
  setTimeout(() => {
    document.getElementById("container").value = d.container || "";
    document.getElementById("vehicleNumber").value = d.vehicleNumber || "";
    if (d.buyer)  document.getElementById("buyer").value = d.buyer;
    if (d.marker) document.getElementById("marker").value = d.marker;
    if (d.unit)   document.getElementById("unit").value = d.unit;
    if (d.masterBatchType) document.getElementById("masterBatchType").value = d.masterBatchType;
    if (d.colour) { document.getElementById("colour").value = d.colour; document.getElementById("colourInput").value = d.colourInput || d.colour; }
    if (d.masterThickness) document.getElementById("masterThickness").value = d.masterThickness;
    if (d.masterFinish) document.getElementById("masterFinish").value = d.masterFinish;
    if (d.masterQuality) document.getElementById("masterQuality").value = d.masterQuality;
    if (d.measurementMode) selectMode(d.measurementMode);
    batches = d.batches || [];
    renderAllBatches();
    updateStats();
    updateMbControls();
    if (d.container) onContainerBlur();
  }, 150);
}

document.addEventListener("input",  saveDraft);
document.addEventListener("change", saveDraft);

/* ═══════════════════════════════════════════════════════════
   ENTER / "DONE" ADVANCES TO THE NEXT FIELD
   Typing in a field and hitting the keyboard's Enter/Go/Done key
   moves focus to the next visible input/select in the form,
   instead of just closing the keyboard. Remarks textarea is
   excluded so Enter still inserts a newline there.
   ═══════════════════════════════════════════════════════════ */
function focusNextField(current) {
  const focusable = Array.from(
    document.querySelectorAll('input:not([type=hidden]):not([readonly]), select')
  ).filter(el => el.offsetParent !== null); // only currently visible fields
  const idx = focusable.indexOf(current);
  if (idx > -1 && idx < focusable.length - 1) {
    const next = focusable[idx + 1];
    next.focus();
    if (typeof next.select === "function" && next.tagName === "INPUT") {
      try { next.select(); } catch (e) {}
    }
  } else {
    current.blur();
  }
}
document.addEventListener("keydown", function(e) {
  if (e.key !== "Enter") return;
  const t = e.target;
  if (!t || t.tagName === "TEXTAREA") return; // allow newlines in remarks
  if (t.tagName === "INPUT" || t.tagName === "SELECT") {
    e.preventDefault();
    focusNextField(t);
  }
});

/* ═══════════════════════════════════════════════════════════
   AUTH
   ═══════════════════════════════════════════════════════════ */
const SESSION_KEY = "msmt_session";
const REMEMBER_KEY = "msmt_remember";
let _authMode = "login";
function getSession() { try { return JSON.parse(localStorage.getItem(SESSION_KEY)||"null"); } catch(e){return null;} }
function setSession(u) { localStorage.setItem(SESSION_KEY, JSON.stringify({username:u,loggedInAt:Date.now()})); }
function clearSession() { localStorage.removeItem(SESSION_KEY); }
function getRemembered() { try { return JSON.parse(localStorage.getItem(REMEMBER_KEY)||"null"); } catch(e){return null;} }
function setRemembered(u,p) { localStorage.setItem(REMEMBER_KEY, JSON.stringify({username:u,password:p})); }
function clearRemembered() { localStorage.removeItem(REMEMBER_KEY); }
function showAuthOverlay(mode) {
  _authMode = mode || "login";
  const t=document.getElementById("authTitle"), s=document.getElementById("authSubtitle");
  const lm=document.getElementById("authLockedMsg"), lu=document.getElementById("authLockedUser");
  const sw=document.getElementById("authSwitchUser"), u=document.getElementById("authUsername");
  const p=document.getElementById("authPassword"), r=document.getElementById("authRemember");
  const e=document.getElementById("authError");
  e.style.display="none"; p.value="";
  if (_authMode==="lock") {
    const ses = getSession()||getRemembered();
    t.textContent="🔒 Locked"; s.textContent="Enter password to unlock";
    lm.style.display="block"; lu.textContent=(ses&&ses.username)||"user";
    u.value=(ses&&ses.username)||""; u.setAttribute("readonly","readonly");
    r.checked=false; r.parentElement.style.display="none"; sw.style.display="block";
  } else {
    t.textContent="Login"; s.textContent="Enter credentials";
    lm.style.display="none"; u.removeAttribute("readonly");
    r.parentElement.style.display=""; sw.style.display="none";
    const rem = getRemembered();
    if (rem) { u.value=rem.username||""; p.value=rem.password||""; r.checked=true; }
    else { u.value=""; r.checked=false; }
  }
  document.getElementById("authOverlay").style.display="flex";
  document.getElementById("authLoginBtn").textContent = _authMode==="lock" ? "UNLOCK" : "LOGIN";
}
function hideAuthOverlay() { document.getElementById("authOverlay").style.display="none"; }
function showAuthError(msg) { const e=document.getElementById("authError"); e.textContent=msg; e.style.display="block"; }
function doLogin() {
  const u=document.getElementById("authUsername").value.trim();
  const p=document.getElementById("authPassword").value;
  const r=document.getElementById("authRemember").checked;
  const b=document.getElementById("authLoginBtn");
  if (!u||!p) { showAuthError("Enter username and password"); return; }
  b.disabled=true; b.textContent = _authMode==="lock" ? "Unlocking..." : "Logging in...";
  google.script.run
    .withSuccessHandler(function(res) {
      b.disabled=false; b.textContent = _authMode==="lock" ? "UNLOCK" : "LOGIN";
      if (res && res.ok) {
        setSession(res.username);
        if (_authMode==="login") { if (r) setRemembered(res.username, p); else clearRemembered(); }
        hideAuthOverlay(); showLoggedInUI(res.username);
        if (!window._appBooted) { window._appBooted=true; loadMasterData(); }
        if (!stuffingType) showStuffingOverlay();
      } else showAuthError((res&&res.message)||"Login failed");
    })
    .withFailureHandler(function(err) { b.disabled=false; b.textContent = _authMode==="lock" ? "UNLOCK" : "LOGIN"; showAuthError("Connection error"); })
    .verifyLogin(u, p);
}
function lockApp() { if (confirm("Lock the app?")) showAuthOverlay("lock"); }
function switchUser() { if (confirm("Switch user?")) { clearSession(); clearRemembered(); showAuthOverlay("login"); } }
function showLoggedInUI(u) {
  document.getElementById("userBadgeName").textContent = u;
  document.getElementById("userBadge").style.display = "flex";
  document.getElementById("lockBtn").style.display = "flex";
}
function getCurrentUsername() { const s = getSession(); return (s && s.username) || ""; }
function bootApp() {
  const s = getSession();
  if (s && s.username) {
    hideAuthOverlay(); showLoggedInUI(s.username); window._appBooted=true; loadMasterData();
    if (!stuffingType) showStuffingOverlay();
  }
  else showAuthOverlay("login");
}

/* ═══════════════════════════════════════════════════════════
   STUFFING TYPE — Crate Loading vs Loose Stuffing
   Required popup right after login. Gates whether Crate No.
   fields (per Master Batch, and per slab) are shown at all.
   ═══════════════════════════════════════════════════════════ */
function showStuffingOverlay() {
  document.getElementById("stuffingOverlay").style.display = "flex";
}
function selectStuffingType(type) {
  stuffingType = type; // "crate" or "loose"
  document.getElementById("stuffingOverlay").style.display = "none";
  updateStuffingBadge();
  renderAllBatches(); // re-render so crate fields show/hide immediately
  saveDraft();
}
function changeStuffingType() {
  if (!confirm("Change stuffing type?\n\nSwitching will show/hide Crate No. fields accordingly. Any Crate No. values already entered are kept but hidden if you switch to Loose Stuffing.")) return;
  document.getElementById("stuffingOverlay").style.display = "flex";
}
function updateStuffingBadge() {
  const btn = document.getElementById("stuffingBadgeBtn");
  if (!btn) return;
  if (!stuffingType) { btn.style.display = "none"; return; }
  btn.style.display = "flex";
  btn.textContent = stuffingType === "crate" ? "🚛" : "📦";
  btn.title = "Stuffing: " + (stuffingType === "crate" ? "Crate Loading" : "Loose Stuffing") + " (tap to change)";
}
bootApp();
</script>
